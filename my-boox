def _require_deps():
    """Fail loudly and early if the managed venv is missing or half-built.
    Without this the first network call reaches `requests.request` with
    `requests` still None and reports "'NoneType' object has no attribute
    'RequestException'", which says nothing about the actual problem."""
    missing = [name for name, mod in (("requests", requests), ("oss2", oss2))
               if mod is None]
    if missing:
        die(
            "my-boox: missing dependenc" +
            ("ies: " if len(missing) > 1 else "y: ") + ", ".join(missing) +
            f" -- the managed venv at {VENV_DIR} is absent or incomplete. "
            f"Remove that directory and re-run to rebuild it.",
            203,
        )

