#!/usr/bin/env python3
"""
my-boox -- send, list, and delete files on an Onyx BOOX device via BOOXDrop.

Self-contained single-file CLI. v3.0 is a deliberate breaking rewrite: it
drops all reliance on Onyx's legacy `api/1/push/message` listing (which is
not reliably kept in sync with real device state -- confirmed repeatedly to
keep showing files long after they were actually deleted, and to sometimes
use a completely different id than the file's real /neocloud/ document) in
favor of /neocloud/ (a Couchbase Sync Gateway instance, confirmed to be
what actually drives device delivery) as the sole source of truth, backed
by a small local incremental cache so `ls` stays cheap after the first run.

No backwards compatibility with the v2.x state-tracking file or ids sourced
from `push/message` -- ids from an old `ls` output will not work with this
version. Run the one-time cleanup script (see README) before switching.

  - proper auth-failure detection (checks HTTP status / result_code instead
    of assuming any 'data' key shape means success or failure)
  - automatic re-authentication: on an auth failure, requests a fresh
    verification code, prompts for it, obtains a new token, saves it, and
    retries the action once
  - a central pacing/retry layer every outgoing request goes through
  - `send` writes its own /neocloud/ document (confirmed necessary for real
    delivery), then a repush-style revision bump on that SAME document,
    mimicking the real web UI's own "repush" button -- safe to do because
    it's bumping a document this tool fully controls end to end, unlike an
    earlier abandoned attempt to bump saveAndPush's separate, asynchronous
    document (which raced and failed)
  - a self-managed virtualenv under ~/.python.venv/my-boox (created and
    populated with its two dependencies -- requests, oss2 -- on first run;
    this script re-execs itself under that interpreter automatically)
  - --config/--create-config and -D/--debug, matching this user's other
    my-* script conventions

Usage:
  my-boox [-D|--debug] [--config [PATH]] send FILE [FILE...]
  my-boox [-D|--debug] [--config [PATH]] ls|list
  my-boox [-D|--debug] [--config [PATH]] del|delete ID [ID...]
  my-boox --config [PATH]           # print resolved config path and exit
  my-boox --create-config [PATH]    # print (or write) a template config

Config search order (first match wins): /LINKS/default/ -> ~/ -> /etc/ ->
/usr/local/etc/, filename my-boox.ini. Config format:

  [default]
  email =
  token =
  cloud = eur.boox.com

err codes:
  201  wrong usage / missing arg / unknown command
  202  file not found (send only)
  203  venv bootstrap failed
  204  action failed even after re-auth retry
  205  re-auth step itself failed (no email configured / no code entered /
       request-code or obtain-token call failed)
  206  no config file found and none could be resolved
"""

import os
import sys


def die(msg, code=1):
    """Write msg to stderr and exit with an explicit numeric code.
    (sys.exit(str) always returns exit code 1 regardless of message
    content, which isn't good enough for our documented err codes.)"""
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(code)


# ---------------------------------------------------------------------------
# Self-bootstrapping venv -- runs before anything else, before any non-stdlib
# imports. If we're not already inside our managed venv, create it (once),
# install the two deps into it, and re-exec this same script under it.
# ---------------------------------------------------------------------------

VENV_DIR = os.path.expanduser("~/.python.venv/my-boox")
_VENV_MARKER = "_MY_BOOX_VENV_ACTIVE"


def _bootstrap_venv():
    if os.environ.get(_VENV_MARKER) == "1":
        return

    import subprocess

    python_bin = os.path.join(VENV_DIR, "bin", "python3")

    if not os.path.exists(python_bin):
        sys.stderr.write(f"my-boox: setting up venv at {VENV_DIR} (first run)...\n")
        try:
            subprocess.check_call([sys.executable, "-m", "venv", VENV_DIR])
            subprocess.check_call(
                [python_bin, "-m", "pip", "install", "--quiet", "--upgrade", "pip"]
            )
            subprocess.check_call(
                [python_bin, "-m", "pip", "install", "--quiet",
                 "requests", "oss2>=2.16"]
            )
        except subprocess.CalledProcessError as e:
            die(f"my-boox: venv bootstrap failed ({e}); "
                f"remove {VENV_DIR} and retry, or check network access", 203)
        except OSError as e:
            die(f"my-boox: venv bootstrap failed ({e})", 203)

    os.environ[_VENV_MARKER] = "1"
    os.execv(python_bin, [python_bin] + sys.argv)


_bootstrap_venv()

# ---------------------------------------------------------------------------
# From here on we're guaranteed to be running inside the managed venv, so
# these imports are safe.
# ---------------------------------------------------------------------------

import configparser
import json
import locale
import subprocess
import time
import uuid

import requests
import oss2

DEFAULT_CLOUD = "eur.boox.com"
CONFIG_FILENAME = "my-boox.ini"
CONFIG_SEARCH_DIRS = ["/LINKS/default", os.path.expanduser("~"), "/etc", "/usr/local/etc"]
KNOWN_CMDS = {"send", "ls", "list", "del", "delete"}

CONFIG_TEMPLATE = """[default]
email =
token =
cloud = eur.boox.com
api_pacing_seconds = 1.5
api_retry_attempts = 3
api_retry_delay_seconds = 3.0
duplicate_check_on_send = true
"""

# Defaults for the config keys above -- also used as load_config()'s
# fallback values, so the template and the actual defaults can't drift
# apart.
DEFAULT_PACING = 1.5      # seconds between requests
DEFAULT_RETRY_ATTEMPTS = 3
DEFAULT_RETRY_DELAY = 3.0  # seconds; multiplied by attempt number


def _config_float(config, key, default):
    try:
        return config["default"].getfloat(key, fallback=default)
    except ValueError:
        return default


def _config_int(config, key, default):
    try:
        return config["default"].getint(key, fallback=default)
    except ValueError:
        return default


def _config_bool(config, key, default):
    try:
        return config["default"].getboolean(key, fallback=default)
    except ValueError:
        return default


VERSION = "3.0"
# Fallback for --version when git isn't available (e.g. this script was
# copied somewhere without its .git directory). Update this to the actual
# commit right when tagging a release. When git IS available, --version
# prefers the live commit hash instead, so this only matters as a fallback.
GIT_COMMIT_FALLBACK = "unknown"


def _get_git_commit():
    script_dir = os.path.dirname(os.path.realpath(__file__))
    try:
        result = subprocess.run(
            ["git", "-C", script_dir, "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0:
            return None
        commit = result.stdout.strip()
        dirty = subprocess.run(
            ["git", "-C", script_dir, "status", "--porcelain"],
            capture_output=True, text=True, timeout=5,
        )
        if dirty.returncode == 0 and dirty.stdout.strip():
            commit += "-dirty"
        return commit
    except (OSError, subprocess.SubprocessError):
        return None


class BooxAuthError(Exception):
    """Raised when the API call fails due to an invalid/expired token or
    a rejected credential exchange (HTTP 4xx/5xx, or a nonzero result_code).
    Triggers the automatic re-auth flow."""


class BooxAPIError(Exception):
    """Raised for anything else that goes wrong talking to the API (bad
    JSON, an unexpected response shape). Not auto-retried."""


# ---------------------------------------------------------------------------
# Config handling
# ---------------------------------------------------------------------------

def resolve_config_path(required=False):
    for d in CONFIG_SEARCH_DIRS:
        p = os.path.join(d, CONFIG_FILENAME)
        if os.path.isfile(p):
            return p
    if required:
        die(
            "my-boox: no config found in " + ", ".join(CONFIG_SEARCH_DIRS) +
            " -- run 'my-boox --create-config' to create one",
            206,
        )
    return os.path.join(CONFIG_SEARCH_DIRS[0], CONFIG_FILENAME)


def load_config(path):
    config = configparser.ConfigParser()
    if os.path.isfile(path):
        config.read(path)
    if "default" not in config:
        config["default"] = {}
    config["default"].setdefault("email", "")
    config["default"].setdefault("token", "")
    config["default"].setdefault("cloud", DEFAULT_CLOUD)
    config["default"].setdefault("api_pacing_seconds", str(DEFAULT_PACING))
    config["default"].setdefault("api_retry_attempts", str(DEFAULT_RETRY_ATTEMPTS))
    config["default"].setdefault("api_retry_delay_seconds", str(DEFAULT_RETRY_DELAY))
    config["default"].setdefault("duplicate_check_on_send", "true")
    return config


def save_config(path, config):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(path, "w") as f:
        config.write(f)


# ---------------------------------------------------------------------------
# Local cache of /neocloud/ contents -- the sole source of truth for `ls`
# and `del`. Keyed by the real neocloud document id.
# ---------------------------------------------------------------------------

def cache_path_for(config_path):
    return config_path + ".neocloud-cache.json"


def load_cache(config_path):
    path = cache_path_for(config_path)
    if not os.path.isfile(path):
        return {"last_seq": "0", "docs": {}}
    try:
        with open(path) as f:
            data = json.load(f)
        data.setdefault("last_seq", "0")
        data.setdefault("docs", {})
        return data
    except (ValueError, OSError):
        return {"last_seq": "0", "docs": {}}


def save_cache(config_path, cache):
    path = cache_path_for(config_path)
    with open(path, "w") as f:
        json.dump(cache, f, indent=2)


# ---------------------------------------------------------------------------
# API layer
# ---------------------------------------------------------------------------

def _get(d, *keys):
    cur = d
    for k in keys:
        if not isinstance(cur, dict) or k not in cur or cur[k] is None:
            raise BooxAPIError(f"unexpected API response shape (missing '{k}')")
        cur = cur[k]
    return cur


# Populated once in main() from config (api_pacing_seconds/api_retry_attempts/
# api_retry_delay_seconds); these module-level defaults are the fallback for
# any code path that runs before that (there isn't one currently, but keeps
# _paced_request() safe to call regardless of init order).
API_PACING = DEFAULT_PACING
API_RETRY_ATTEMPTS = DEFAULT_RETRY_ATTEMPTS
API_RETRY_DELAY = DEFAULT_RETRY_DELAY

_LAST_REQUEST_TIME = 0.0


def _paced_request(method, url, headers=None, params=None, data=None,
                     timeout=30, debug=False):
    """Single choke point for every outgoing HTTP request this tool makes --
    both api/1/* (Bearer-authenticated) and /neocloud/* (cookie-
    authenticated) calls route through here. Enforces a minimum pacing
    interval between consecutive requests and retries transient failures
    (connection errors, timeouts, 502/503/504) with backoff before giving
    up. Onyx's backend throws noticeably more of these under back-to-back
    requests -- centralizing this here fixes it for every command (send,
    del, ls) uniformly. Non-transient responses (200, 404, 4xx, etc.) are
    returned as-is on the first try; interpreting them is the caller's job."""
    global _LAST_REQUEST_TIME
    last_err = None
    for attempt in range(1, API_RETRY_ATTEMPTS + 1):
        if API_PACING > 0:
            wait = API_PACING - (time.monotonic() - _LAST_REQUEST_TIME)
            if wait > 0:
                time.sleep(wait)
        _LAST_REQUEST_TIME = time.monotonic()

        try:
            resp = requests.request(method, url, headers=headers, params=params,
                                      data=data, timeout=timeout)
        except requests.RequestException as e:
            last_err = e
        else:
            if resp.status_code not in (502, 503, 504):
                return resp
            last_err = BooxAPIError(f"HTTP {resp.status_code} from {url}")

        if attempt < API_RETRY_ATTEMPTS:
            delay = API_RETRY_DELAY * attempt
            if debug:
                sys.stderr.write(
                    f">>> request failed (attempt {attempt}/{API_RETRY_ATTEMPTS}): "
                    f"{last_err}\n>>> retrying in {delay:.0f}s...\n"
                )
            time.sleep(delay)

    if isinstance(last_err, requests.RequestException):
        raise BooxAPIError(f"network error calling {url}: {last_err}") from last_err
    raise last_err


def api_call(cloud, token, api_url, method="GET", headers=None, data=None,
             params=None, api="api/1", debug=False):
    headers = dict(headers or {})
    body = None

    if token:
        headers["Authorization"] = f"Bearer {token}"

    if data:
        headers["Content-Type"] = "application/json;charset=utf-8"
        method = "POST"
        body = json.dumps(data)

    url = f"https://{cloud}/{api}/{api_url}"
    if debug:
        sys.stderr.write(f">>> {method} {url}\n")
        if params:
            sys.stderr.write(f">>> params: {json.dumps(params)}\n")
        if body:
            sys.stderr.write(f">>> body: {body}\n")

    resp = _paced_request(method, url, headers=headers, params=params,
                            data=body, debug=debug)

    try:
        payload = resp.json()
    except ValueError as e:
        raise BooxAPIError(
            f"non-JSON response (HTTP {resp.status_code}) from {api_url}: "
            f"{resp.text[:200]}"
        ) from e

    if debug:
        sys.stderr.write(f"<<< {json.dumps(payload, indent=2)}\n")

    result_code = payload.get("result_code") if isinstance(payload, dict) else None
    if resp.status_code >= 400 or (result_code is not None and result_code != 0):
        msg = payload.get("message", f"HTTP {resp.status_code}") if isinstance(payload, dict) else f"HTTP {resp.status_code}"
        raise BooxAuthError(f"{api_url} failed: {msg}")

    return payload


def do_request_code(cloud, email, debug=False):
    api_call(cloud, None, "users/sendMobileCode", data={"mobi": email}, debug=debug)


def do_obtain_token(cloud, email, code, debug=False):
    payload = api_call(
        cloud, None, "users/signupByPhoneOrEmail",
        data={"mobi": email, "code": code}, debug=debug,
    )
    return _get(payload, "data", "token")


def get_uid(cloud, token, debug=False):
    payload = api_call(cloud, token, "users/me", debug=debug)
    return _get(payload, "data", "uid")


def get_neocloud_cookie(cloud, token, debug=False):
    """The actual device-facing storage is a Couchbase Sync Gateway instance
    at /neocloud/ (confirmed by its CouchDB-style _revs_diff/_bulk_docs/
    _changes API and a 'SyncGatewaySession' cookie), completely separate
    from the Bearer-token-authenticated api/1/* REST layer. users/syncToken
    is itself a normal Bearer-authenticated call that hands back the
    session id the browser then uses as that cookie -- so no browser/login
    flow is needed to obtain it."""
    payload = api_call(cloud, token, "users/syncToken", debug=debug)
    return _get(payload, "data", "session_id")


def neocloud_request(cloud, session_id, method, path, json_body=None,
                       params=None, debug=False):
    headers = {"Cookie": f"SyncGatewaySession={session_id}"}
    body = None
    if json_body is not None:
        headers["Content-Type"] = "application/json"
        body = json.dumps(json_body)

    url = f"https://{cloud}/neocloud/{path}"
    if debug:
        sys.stderr.write(f">>> {method} {url}\n")
        if body:
            sys.stderr.write(f">>> body: {body}\n")

    resp = _paced_request(method, url, headers=headers, params=params,
                            data=body, debug=debug)

    try:
        result = resp.json()
    except ValueError as e:
        raise BooxAPIError(
            f"non-JSON response (HTTP {resp.status_code}) from neocloud/{path}: "
            f"{resp.text[:200]}"
        ) from e

    if debug:
        sys.stderr.write(f"<<< {json.dumps(result, indent=2)}\n")

    if resp.status_code >= 400:
        raise BooxAPIError(f"neocloud/{path} failed: HTTP {resp.status_code}: {result}")

    return result


def neocloud_get_doc(cloud, session_id, neocloud_id, debug=False):
    """Plain GET /neocloud/<id> -- returns the full document dict (including
    _rev, name, size, etc.) for a live document, or None if the id doesn't
    exist there (404) -- both for ids that never existed, and for ids that
    were already deleted (a deleted document also 404s on a plain GET,
    indistinguishable from never having existed)."""
    headers = {"Cookie": f"SyncGatewaySession={session_id}"}
    url = f"https://{cloud}/neocloud/{neocloud_id}"
    if debug:
        sys.stderr.write(f">>> GET {url}\n")

    resp = _paced_request("GET", url, headers=headers, debug=debug)

    if resp.status_code == 404:
        if debug:
            sys.stderr.write("<<< 404 (not found)\n")
        return None

    try:
        result = resp.json()
    except ValueError as e:
        raise BooxAPIError(
            f"non-JSON response (HTTP {resp.status_code}) looking up "
            f"neocloud/{neocloud_id}: {resp.text[:200]}"
        ) from e

    if debug:
        sys.stderr.write(f"<<< {json.dumps(result, indent=2)}\n")

    if resp.status_code >= 400:
        raise BooxAPIError(f"neocloud/{neocloud_id} lookup failed: HTTP {resp.status_code}: {result}")

    return result


def neocloud_delete_doc(cloud, token, neocloud_id, current_rev, debug=False):
    """Submit a proper CouchDB/Sync Gateway tombstone for a document we
    know the real current revision of. The new tombstone revision becomes
    start+1 with current_rev's hash as its parent in _revisions."""
    start, parent_hash = current_rev.split("-", 1)
    new_hash = uuid.uuid4().hex
    new_start = int(start) + 1

    session_id = get_neocloud_cookie(cloud, token, debug=debug)
    doc = {
        "_deleted": True,
        "_id": neocloud_id,
        "_rev": f"{new_start}-{new_hash}",
        "_revisions": {"start": new_start, "ids": [new_hash, parent_hash]},
    }
    neocloud_request(cloud, session_id, "POST", "_bulk_docs",
                      json_body={"docs": [doc], "new_edits": False}, debug=debug)


def refresh_cache(cloud, token, config_path, debug=False):
    """Incrementally sync the local cache with /neocloud/: one cheap
    _changes call for everything since the last known cursor (id + rev +
    deleted-status for every changed document), then fetches the full body
    (name/size/etc.) only for genuinely new or changed LIVE documents.
    Cheap on every call after the first; the first run pays the cost of
    fetching every existing file's body once. Returns the up-to-date
    {doc_id: {"name":, "size":, "rev":, "createdAt":, "updatedAt":}} dict."""
    uid = get_uid(cloud, token, debug=debug)
    channel = f"{uid}-MESSAGE"
    session_id = get_neocloud_cookie(cloud, token, debug=debug)

    cache = load_cache(config_path)
    result = neocloud_request(
        cloud, session_id, "GET", "_changes",
        params={
            "style": "all_docs",
            "filter": "sync_gateway/bychannel",
            "channels": channel,
            "since": cache["last_seq"],
        },
        debug=debug,
    )

    for r in result.get("results", []):
        doc_id = r.get("id")
        if not doc_id:
            continue
        if r.get("deleted"):
            cache["docs"].pop(doc_id, None)
            continue
        changes = r.get("changes", [])
        if not changes:
            continue
        doc = neocloud_get_doc(cloud, session_id, doc_id, debug=debug)
        if doc:
            cache["docs"][doc_id] = {
                "name": doc.get("name"),
                "size": doc.get("size"),
                "rev": doc.get("_rev", changes[0]["rev"]),
                "createdAt": doc.get("createdAt"),
                "updatedAt": doc.get("updatedAt"),
            }
        else:
            cache["docs"].pop(doc_id, None)

    cache["last_seq"] = result.get("last_seq", cache["last_seq"])
    save_cache(config_path, cache)
    return cache["docs"]


def neocloud_write_doc(cloud, session_id, doc_id, rev_str, revisions, uid,
                         basename, resource_type, remotename, size,
                         sign_url_fn, debug=False):
    """Shared low-level write used by both the initial create (rev 1) and
    the repush-style bump (rev 2+) -- same document shape either way,
    only _rev/_revisions differ."""
    now_ms = int(time.time() * 1000)
    content_obj = {
        "_id": doc_id,
        "createdAt": now_ms,
        "distributeChannel": "onyx",
        "formats": [resource_type],
        "guid": doc_id,
        "name": basename,
        "ownerId": uid,
        "size": size,
        "md5": "",
        "storage": {
            resource_type: {
                "oss": {
                    "displayName": basename,
                    "expires": 0,
                    "key": remotename,
                    "provider": "oss",
                    "size": size,
                    "url": sign_url_fn(remotename),
                }
            }
        },
        "title": basename,
        "updatedAt": now_ms,
    }
    doc = {
        "contentType": "digital_content",
        "content": json.dumps(content_obj, separators=(",", ":")),
        "msgType": 2,
        "dbId": f"{uid}-MESSAGE",
        "user": uid,
        "name": basename,
        "size": size,
        "uniqueId": doc_id,
        "createdAt": now_ms,
        "updatedAt": now_ms,
        "_id": doc_id,
        "_rev": rev_str,
        "_revisions": revisions,
    }
    rev_hash = rev_str.split("-", 1)[1]
    neocloud_request(cloud, session_id, "POST", "_revs_diff",
                      json_body={doc_id: [rev_str]}, debug=debug)
    neocloud_request(cloud, session_id, "POST", "_bulk_docs",
                      json_body={"docs": [doc], "new_edits": False}, debug=debug)


def do_send(cloud, token, filename, debug=False):
    uid = get_uid(cloud, token, debug=debug)
    api_call(cloud, token, "users/getDevice", debug=debug)
    api_call(cloud, token, "im/getSig", params={"user": uid}, debug=debug)

    buckets = api_call(cloud, token, "config/buckets", debug=debug)
    onyx_cloud = _get(buckets, "data", "onyx-cloud")
    bucket_name = onyx_cloud["bucket"]
    endpoint = onyx_cloud["aliEndpoint"]

    stss = api_call(cloud, token, "config/stss", debug=debug)
    stss_data = _get(stss, "data")
    access_key_id = stss_data["AccessKeyId"]
    access_key_secret = stss_data["AccessKeySecret"]
    security_token = stss_data["SecurityToken"]

    auth = oss2.StsAuth(access_key_id, access_key_secret, security_token)
    bucket = oss2.Bucket(auth, endpoint, bucket_name)

    _, extension = os.path.splitext(filename)
    remotename = f"{uid}/push/{uuid.uuid4()}{extension}"
    oss2.resumable_upload(bucket, remotename, filename)

    basename = os.path.basename(filename)
    resource_type = extension.lstrip(".").lower() or "txt"
    size = os.path.getsize(filename)

    sign_url_fn = lambda key: bucket.sign_url(
        "GET", key, 3 * 3600,
        params={"response-content-disposition": "attachment"},
    )

    # 1. Our own neocloud document (confirmed necessary for real device
    #    delivery -- saveAndPush's own server-side write alone was tried
    #    and failed to deliver a whole batch of real files).
    doc_id = uuid.uuid4().hex
    rev1_hash = uuid.uuid4().hex
    session_id = get_neocloud_cookie(cloud, token, debug=debug)
    try:
        neocloud_write_doc(
            cloud, session_id, doc_id, f"1-{rev1_hash}", {"start": 1, "ids": [rev1_hash]},
            uid, basename, resource_type, remotename, size, sign_url_fn, debug=debug,
        )
    except (BooxAPIError, BooxAuthError) as e:
        raise BooxAPIError(
            f"neocloud delivery write failed: {e} -- nothing was "
            f"registered or delivered, safe to just retry 'send'"
        ) from e

    # 2. saveAndPush -- kept even though we no longer read its listing,
    #    since we don't have evidence it's safe to drop (an earlier
    #    attempt to rely on ITS write alone, without our own, delivered
    #    none of a 14-file batch).
    try:
        api_call(
            cloud, token, "push/saveAndPush",
            data={
                "data": {
                    "bucket": bucket_name,
                    "name": basename,
                    "parent": None,
                    "resourceDisplayName": basename,
                    "resourceKey": remotename,
                    "resourceType": resource_type,
                    "title": basename,
                }
            },
            debug=debug,
        )
    except (BooxAPIError, BooxAuthError) as e:
        if debug:
            sys.stderr.write(f"my-boox: saveAndPush failed (non-fatal, continuing): {e}\n")

    # 3. Repush-style reinforcement: bump a NEW revision onto our OWN
    #    document, mimicking the real web UI's "repush" button exactly
    #    (confirmed from a captured HAR: _revs_diff + _bulk_docs onto the
    #    same id, no saveAndPush call at all). Safe here specifically
    #    because it's our own write path end to end -- unlike an earlier
    #    abandoned attempt to bump saveAndPush's separate, asynchronous
    #    document, which raced and failed with 504s twice in a row.
    #    Non-fatal if it fails: the initial write already succeeded.
    final_rev = f"1-{rev1_hash}"
    try:
        rev2_hash = uuid.uuid4().hex
        rev2 = f"2-{rev2_hash}"
        neocloud_write_doc(
            cloud, session_id, doc_id, rev2, {"start": 2, "ids": [rev2_hash, rev1_hash]},
            uid, basename, resource_type, remotename, size, sign_url_fn, debug=debug,
        )
        final_rev = rev2
    except (BooxAPIError, BooxAuthError) as e:
        if debug:
            sys.stderr.write(f"my-boox: repush reinforcement failed (non-fatal): {e}\n")

    return doc_id, final_rev, basename, size


# ---------------------------------------------------------------------------
# Re-auth wrapper
# ---------------------------------------------------------------------------

def with_reauth(action, config, config_path, debug=False):
    """Run action(token) with the stored token. On BooxAuthError, request a
    fresh verification code, prompt for it, obtain a new token, save it, and
    retry once. Raises SystemExit on any unrecoverable failure."""

    token = config["default"].get("token") or None

    try:
        return action(token)
    except BooxAuthError as e:
        if debug:
            sys.stderr.write(f"my-boox: first attempt failed: {e}\n")

        email = config["default"].get("email", "")
        if not email:
            die(
                "my-boox: no email configured -- run 'my-boox --create-config' "
                "and fill in 'email'",
                205,
            )
        cloud = config["default"].get("cloud") or DEFAULT_CLOUD

        sys.stderr.write("my-boox: auth failed, requesting a fresh verification code...\n")
        try:
            do_request_code(cloud, email, debug=debug)
        except (BooxAuthError, BooxAPIError) as e2:
            die(f"my-boox: requesting verification code failed: {e2}", 205)
        sys.stderr.write("Code for token requested. Check email.\n")

        code = input(f"Check {email} for the 6-digit code, then enter it: ").strip()
        if not code:
            die("my-boox: no code entered, aborting", 205)

        try:
            new_token = do_obtain_token(cloud, email, code, debug=debug)
        except (BooxAuthError, BooxAPIError) as e2:
            die(f"my-boox: obtaining token failed: {e2}", 205)

        config["default"]["token"] = new_token
        save_config(config_path, config)

        try:
            return action(new_token)
        except BooxAuthError as e2:
            die(f"my-boox: still failing after re-auth retry: {e2}", 204)


# ---------------------------------------------------------------------------
# Command handlers
# ---------------------------------------------------------------------------

def cmd_send(config, config_path, filenames, debug=False):
    cloud = config["default"].get("cloud") or DEFAULT_CLOUD
    failures = []

    check_duplicates = _config_bool(config, "duplicate_check_on_send", True)

    existing = set()
    if check_duplicates:
        def fetch_existing(token):
            return refresh_cache(cloud, token, config_path, debug=debug)

        try:
            docs = with_reauth(fetch_existing, config, config_path, debug=debug) or {}
        except (BooxAPIError, BooxAuthError) as e:
            sys.stderr.write(f"my-boox: duplicate check failed, continuing without it: {e}\n")
            docs = {}
        for meta in docs.values():
            name, size = meta.get("name"), meta.get("size")
            if name is not None and size is not None:
                existing.add((name, size))

    for raw_filename in filenames:
        filename = os.path.abspath(os.path.expanduser(raw_filename))
        if not os.path.isfile(filename):
            sys.stderr.write(f"my-boox: file not found: {filename}\n")
            failures.append(raw_filename)
            continue

        basename = os.path.basename(filename)
        size = os.path.getsize(filename)
        if check_duplicates and (basename, size) in existing:
            print(f"skipped: {basename} (already present, same name and size)")
            continue

        def action(token, filename=filename):
            return do_send(cloud, token, filename, debug=debug)

        try:
            result = with_reauth(action, config, config_path, debug=debug)
        except (BooxAPIError, BooxAuthError) as e:
            sys.stderr.write(f"my-boox: failed to send {basename}: {e}\n")
            failures.append(raw_filename)
            continue

        print(f"sent: {basename}")
        if check_duplicates:
            existing.add((basename, size))

        if result:
            doc_id, rev, name, doc_size = result
            cache = load_cache(config_path)
            cache["docs"][doc_id] = {
                "name": name, "size": doc_size, "rev": rev,
                "createdAt": None, "updatedAt": None,
            }
            save_cache(config_path, cache)

    if failures:
        die(
            f"my-boox: {len(failures)} of {len(filenames)} failed: " +
            ", ".join(failures),
            204,
        )


def cmd_ls(config, config_path, debug=False):
    cloud = config["default"].get("cloud") or DEFAULT_CLOUD

    def action(token):
        return refresh_cache(cloud, token, config_path, debug=debug)

    docs = with_reauth(action, config, config_path, debug=debug) or {}

    rows = []
    for doc_id, meta in docs.items():
        name, size = meta.get("name"), meta.get("size")
        if name is None or size is None:
            continue
        sort_key = meta.get("updatedAt") or meta.get("createdAt") or 0
        rows.append((doc_id, size, name, sort_key))
    rows.sort(key=lambda r: r[3], reverse=True)

    # I would expect LC_ALL to be set but it may not be (kept from upstream,
    # affects the ':>Nn' locale-aware digit grouping below)
    locale.setlocale(locale.LC_ALL, locale.getlocale()[0])

    id_width = max([len(r[0]) for r in rows] + [len("ID")])
    size_width = 10
    name_width = max([len(r[2]) for r in rows] + [len("Name")])

    print(f"{'ID':<{id_width}} | {'Size':>{size_width}} | Name")
    print("-" * id_width + "-|-" + "-" * size_width + "-|-" + "-" * name_width)
    for doc_id, size, name, _ in rows:
        print(f"{doc_id:<{id_width}} | {size:>{size_width}n} | {name}")

    return rows


def do_delete_one(cloud, token, doc_id, debug=False):
    """Delete a single neocloud document directly by its real id -- ids
    come straight from 'ls', which reads /neocloud/ natively now, so
    there's no id-mismatch class of problem to work around any more."""
    session_id = get_neocloud_cookie(cloud, token, debug=debug)
    doc = neocloud_get_doc(cloud, session_id, doc_id, debug=debug)
    if not doc:
        return False
    neocloud_delete_doc(cloud, token, doc_id, doc["_rev"], debug=debug)
    return True


def cmd_del(config, config_path, ids, debug=False):
    cloud = config["default"].get("cloud") or DEFAULT_CLOUD

    succeeded = []
    untracked = []
    failures = []

    for doc_id in ids:
        def action(token, doc_id=doc_id):
            return do_delete_one(cloud, token, doc_id, debug=debug)

        try:
            found = with_reauth(action, config, config_path, debug=debug)
        except (BooxAPIError, BooxAuthError) as e:
            sys.stderr.write(f"my-boox: failed to delete {doc_id}: {e}\n")
            failures.append(doc_id)
            continue

        cache = load_cache(config_path)
        cache["docs"].pop(doc_id, None)
        save_cache(config_path, cache)

        if found:
            print(f"deleted: {doc_id}")
            succeeded.append(doc_id)
        else:
            print(f"deleted: {doc_id} (not found -- already gone, or never existed)")
            untracked.append(doc_id)

    if untracked:
        print(
            "note: no live document found for " + ", ".join(untracked) +
            " -- genuinely ambiguous between already-deleted (common if "
            "re-running del on the same id) and never having existed."
        )
    print("(run 'my-boox ls' to refresh the cache and confirm)")

    if failures:
        die(
            f"my-boox: {len(failures)} of {len(ids)} failed to delete: " +
            ", ".join(failures),
            204,
        )


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def print_usage(to=sys.stderr):
    to.write(
        "usage: my-boox [-D|--debug] [--config [PATH]] send FILE [FILE...]\n"
        "       my-boox [-D|--debug] [--config [PATH]] ls|list\n"
        "       my-boox [-D|--debug] [--config [PATH]] del|delete ID [ID...]\n"
        "       my-boox --config [PATH]\n"
        "       my-boox --create-config [PATH]\n"
        "       my-boox --help\n"
        "       my-boox --version\n"
    )


def print_help(to=sys.stdout):
    to.write(f"""\
my-boox -- send, list, and delete files on an Onyx BOOX device via BOOXDrop.

v3.0: reads and writes /neocloud/ directly (via a local cache), with no
reliance on the legacy push/message listing. Not compatible with ids from
a v2.x 'ls' -- run the one-time cleanup script first if migrating.

USAGE
  my-boox [-D|--debug] [--config [PATH]] send FILE [FILE...]
  my-boox [-D|--debug] [--config [PATH]] ls|list
  my-boox [-D|--debug] [--config [PATH]] del|delete ID [ID...]
  my-boox --config [PATH]
  my-boox --create-config [PATH]
  my-boox --help
  my-boox --version

COMMANDS
  send FILE [FILE...]
                    Upload one or more files. Each write is: (1) our own
                    /neocloud/ document -- confirmed necessary for real
                    device delivery, (2) saveAndPush -- kept as a
                    reinforcement even though its own listing is no longer
                    read, (3) a repush-style revision bump on our own
                    document, mimicking the real web UI's repush button.
                    Skips any file whose name AND size already match
                    something already present (checked once per batch,
                    plus against files sent earlier in the same batch).
                    If a file still fails after retries, the rest of the
                    batch is still attempted; failures are summarized at
                    the end and the exit code is nonzero.

  ls, list         List files, refreshing the local cache incrementally
                    from /neocloud/ first (cheap after the first run).
                    Use the ID shown with 'del'.

  del ID [ID...]   Delete one or more files by ID (as shown by 'ls').
                    Each id is deleted independently and confirmed as it
                    happens; if one fails, the rest of the batch still
                    goes ahead, with a summary and nonzero exit code if
                    anything genuinely failed.

Every request any command makes goes through the same central pacing/retry
layer: a minimum interval between requests, and automatic retries with
backoff on a transient server error (502/503/504, connection errors,
timeouts -- these happen even in the real web client). Configurable via
api_pacing_seconds/api_retry_attempts/api_retry_delay_seconds, see CONFIG
below.

All three automatically handle authentication: if the stored token is
missing, expired, or rejected by the server, my-boox requests a fresh
6-digit verification code by email, prompts you for it, exchanges it for a
new token, saves that token back to the config file, and retries the
command once -- no separate login step to run by hand.

OPTIONS
  -D, --debug        Print the raw JSON of every API call to stderr.
  --config [PATH]     With PATH: use that config file for this run only,
                    instead of the normal search (see CONFIG below).
                    Without PATH, and with no command given: print the
                    config path my-boox would currently resolve to, and
                    exit (does not require the file to actually exist).
  --create-config [PATH]
                    Write a template config file to PATH. Without PATH,
                    print the template to stdout instead (so you can review
                    it, or redirect it wherever you like) -- nothing is
                    written to disk in that case.
  -h, --help         Show this help and exit.
  -V, --version      Show version and git commit, then exit.

CONFIG
  my-boox reads a config file named 'my-boox.ini', in this format:

      [default]
      email =
      token =
      cloud = eur.boox.com
      api_pacing_seconds = 1.5
      api_retry_attempts = 3
      api_retry_delay_seconds = 3.0
      duplicate_check_on_send = true

  email  -- the address tied to your Onyx account. Required: this is who
            re-auth emails a fresh verification code to.
  token  -- filled in automatically the first time you authenticate; leave
            this blank in a fresh config.
  cloud  -- your BOOXDrop server region. 'eur.boox.com' for EU accounts,
            'push.boox.com' for US/VN.
  api_pacing_seconds       -- minimum interval between ANY two requests
            this tool makes. 0 disables it.
  api_retry_attempts       -- how many times to retry any single request
            after a transient server error before giving up on it.
  api_retry_delay_seconds  -- base backoff delay between retries
            (multiplied by the attempt number, so e.g. 3.0 gives 3s, 6s).
  duplicate_check_on_send   -- true/false. When true (default), 'send'
            skips any file whose name AND size already match something
            already present. Set false to always upload regardless.

  SEARCH ORDER (first match wins, no merging across locations):
      1. /LINKS/default/my-boox.ini
      2. ~/my-boox.ini
      3. /etc/my-boox.ini
      4. /usr/local/etc/my-boox.ini

  Run 'my-boox --config' with no other arguments at any time to see exactly
  which of these paths it currently resolves to.

  A '--config PATH' passed alongside a command overrides the search
  entirely for that single run.

LOCAL CACHE
  '<config path>.neocloud-cache.json' mirrors /neocloud/'s contents (id,
  name, size, rev, timestamps), refreshed incrementally on every 'ls' via
  one cheap _changes call plus a body fetch only for new/changed documents.
  This is what 'ls' and 'del' actually read/act on -- delete this file to
  force a full resync from scratch.

SELF-MANAGED VIRTUALENV
  my-boox has two dependencies (requests, oss2) and manages its own
  virtualenv for them automatically -- nothing to pip install by hand.
  On first run, it creates a venv at ~/.python.venv/my-boox, installs both
  packages into it, then re-execs itself under that interpreter. Delete
  that directory to force a clean reinstall.

EXAMPLES
  my-boox --create-config              # see the template
  my-boox --create-config ~/my-boox.ini  # write it there
  my-boox --config                     # where would my-boox look?
  my-boox send report.pdf
  my-boox send a.pdf b.pdf c.pdf        # multiple files in one call
  my-boox ls
  my-boox del <id>
  my-boox del <id1> <id2>
  my-boox -D ls                        # with raw API responses on stderr

EXIT CODES
  201  wrong usage / missing arg / unknown command
  202  file not found (send)
  203  venv bootstrap failed
  204  action failed even after re-auth retry
  205  re-auth step itself failed (no email configured, no code entered,
       or the request-code/obtain-token API call itself failed)
  206  no config file found and none could be resolved
""")


def main(argv):
    debug = False
    config_override = None
    config_flag = False
    create_config_flag = False
    create_config_path = None
    rest = []

    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-D", "--debug"):
            debug = True
        elif a == "--config":
            config_flag = True
            if i + 1 < len(argv) and argv[i + 1] not in KNOWN_CMDS and not argv[i + 1].startswith("-"):
                config_override = argv[i + 1]
                i += 1
        elif a == "--create-config":
            create_config_flag = True
            if i + 1 < len(argv) and argv[i + 1] not in KNOWN_CMDS and not argv[i + 1].startswith("-"):
                create_config_path = argv[i + 1]
                i += 1
        elif a in ("-h", "--help"):
            print_help(sys.stdout)
            return 0
        elif a in ("-V", "--version"):
            commit = _get_git_commit() or GIT_COMMIT_FALLBACK
            print(f"my-boox {VERSION} (commit {commit})")
            return 0
        else:
            rest.append(a)
        i += 1

    if create_config_flag:
        if create_config_path:
            path = os.path.expanduser(create_config_path)
            parent = os.path.dirname(path)
            if parent:
                os.makedirs(parent, exist_ok=True)
            with open(path, "w") as f:
                f.write(CONFIG_TEMPLATE)
            print(f"wrote template config to {path}")
        else:
            sys.stdout.write(CONFIG_TEMPLATE)
        return 0

    if not rest:
        if config_flag:
            print(config_override or resolve_config_path())
            return 0
        print_usage()
        return 201

    cmd = rest[0]
    cmd_args = rest[1:]

    if cmd not in KNOWN_CMDS:
        sys.stderr.write(f"my-boox: unknown command: {cmd} (expected send, ls, or del)\n")
        return 201

    config_path = config_override or resolve_config_path(required=False)
    config = load_config(config_path)

    global API_PACING, API_RETRY_ATTEMPTS, API_RETRY_DELAY
    API_PACING = _config_float(config, "api_pacing_seconds", DEFAULT_PACING)
    API_RETRY_ATTEMPTS = _config_int(config, "api_retry_attempts", DEFAULT_RETRY_ATTEMPTS)
    API_RETRY_DELAY = _config_float(config, "api_retry_delay_seconds", DEFAULT_RETRY_DELAY)

    try:
        if cmd == "send":
            if not cmd_args:
                sys.stderr.write("usage: my-boox send FILE [FILE...]\n")
                return 201
            cmd_send(config, config_path, cmd_args, debug=debug)
            return 0

        if cmd in ("ls", "list"):
            cmd_ls(config, config_path, debug=debug)
            return 0

        if cmd in ("del", "delete"):
            if not cmd_args:
                sys.stderr.write("usage: my-boox del ID [ID...]\n")
                return 201
            cmd_del(config, config_path, cmd_args, debug=debug)
            return 0
    except (BooxAPIError, BooxAuthError) as e:
        die(f"my-boox: {e}", 204)
    except SystemExit:
        raise
    except Exception as e:
        if debug:
            raise
        die(f"my-boox: unexpected error: {e} (rerun with -D for the full traceback)", 204)

    # unreachable given the KNOWN_CMDS check above
    return 201


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
