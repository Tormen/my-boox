class TestCommandHandlers(unittest.TestCase):
    def test_with_reauth_retries_after_auth_failure(self) -> None:
        module = sys.modules[__name__]
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = os.path.join(tmpdir, "my-boox.ini")
            config = load_config(config_path)
            config["default"]["email"] = "user@example.com"
            config["default"]["token"] = "stale"
            save_config(config_path, config)

            attempts = {"count": 0}

            def flaky_action(token: Optional[str]) -> Any:
                attempts["count"] += 1
                if attempts["count"] == 1:
                    raise BooxAuthError("token rejected")
                return token

            # isatty: the interactive path is the one under test here; the
            # non-tty refusal has its own test in TestRegressions.
            with mock.patch.object(module, "do_request_code"), \
                 mock.patch.object(module, "do_obtain_token", return_value="fresh-token"), \
                 mock.patch.object(sys.stdin, "isatty", return_value=True), \
                 mock.patch("builtins.input", return_value="123456"):
                stderr = io.StringIO()
                with contextlib.redirect_stderr(stderr):
                    result = with_reauth(flaky_action, config, config_path, debug=False)

            self.assertEqual(result, "fresh-token")
            reloaded = load_config(config_path)
            self.assertEqual(reloaded["default"]["token"], "fresh-token")

