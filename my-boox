    # -- api_retry_attempts = 0 skipped the loop and raised
    #    "TypeError: exceptions must derive from BaseException".
    def test_zero_retry_attempts_still_makes_one_attempt(self) -> None:
        module = sys.modules[__name__]
        stub = _FakeRequests([_FakeResponse(200, {"result_code": 0})])
        with _no_pacing(module, stub, attempts=0):
            resp = _paced_request("GET", "https://example.invalid/x")
        self.assertEqual(resp.status_code, 200)
        self.assertEqual(len(stub.calls), 1)

    # -- "why was that ls slow" was unanswerable from a -D log: a 504 is an
    #    upstream timeout, so the failed attempt can cost far more than the
    #    backoff that follows, and the log showed neither.
    def test_debug_reports_how_long_each_attempt_took(self) -> None:
        module = sys.modules[__name__]
        stub = _FakeRequests([_FakeResponse(504, {}), _FakeResponse(200, {"result_code": 0})])
        stderr = io.StringIO()
        with _no_pacing(module, stub, attempts=2), \
             contextlib.redirect_stderr(stderr):
            _paced_request("GET", "https://example.invalid/x", debug=True)

        out = stderr.getvalue()
        self.assertIn("HTTP 504", out)
        self.assertIn("HTTP 200", out)
        self.assertEqual(out.count("server "), 2)   # one timing per attempt

    def test_transient_5xx_is_retried_then_succeeds(self) -> None:
        module = sys.modules[__name__]
        stub = _FakeRequests([
            _FakeResponse(504, {}),
            _FakeRequests.RequestException("connection reset"),
            _FakeResponse(200, {"result_code": 0, "data": {"ok": True}}),
