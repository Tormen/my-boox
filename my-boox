                cb = kwargs["data"]["cbMsg"]
                # The server echoes the adopted id back unchanged.
                return {"result_code": 0, "data": {"cbMsg": dict(cb)}}
            return {"result_code": 0, "data": {}}

        written = {}

        def fake_neocloud(cloud: Any, session_id: Any, method: Any, path: Any, json_body: Any = None, **k: Any) -> Any:
            if path == "_bulk_docs":
                doc = json_body["docs"][0]
