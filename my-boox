def run_self_tests(selected_group: Optional[str] = None) -> int:
    groups = {
        "smoke": [TestCliBehavior],
        "core": [TestConfigHandling, TestCacheAndGrouping],
        "commands": [TestCommandHandlers],
        "regressions": [TestRegressions],
        "all": [TestCliBehavior, TestConfigHandling, TestCacheAndGrouping,
                TestCommandHandlers, TestRegressions],
    }

    group = (selected_group or "all").strip().lower()
    if group not in groups:
        sys.stderr.write(
            f"my-boox: unknown test group '{selected_group}' (expected one of: {', '.join(sorted(groups))})\n"
        )
        return 201

    suite = unittest.TestSuite()
    for case in groups[group]:
        suite.addTests(unittest.defaultTestLoader.loadTestsFromTestCase(case))

    result = unittest.TextTestRunner(verbosity=2).run(suite)
    return 0 if result.wasSuccessful() else 1


