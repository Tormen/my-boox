class _FakeResponse:
    """Minimal stand-in for requests.Response -- only the three attributes
    _paced_request/api_call/neocloud_request actually touch."""

    def __init__(self, status_code=200, payload=None, text=""):
        self.status_code = status_code
        self._payload = payload
        self.text = text if text else json.dumps(payload)

    def json(self):
        if self._payload is None:
            raise ValueError("no json")
        return self._payload


class _FakeRequests:
    """Stands in for the `requests` module. Each call pops the next queued
    response (or raises the next queued exception) and records the call."""

    class RequestException(Exception):
        pass

    def __init__(self, queue):
        self._queue = list(queue)
        self.calls = []

    def request(self, method, url, headers=None, params=None, data=None,
                timeout=None):
        self.calls.append({"method": method, "url": url, "headers": headers,
                           "params": params, "data": data})
        nxt = self._queue.pop(0)
        if isinstance(nxt, Exception):
            raise nxt
        return nxt


@contextlib.contextmanager
def _no_pacing(module, requests_stub=None, attempts=None):
    """Run a block with the sleep-based pacing disabled (tests must not
    spend real seconds) and, optionally, a stubbed `requests` module."""
    patches = [
        mock.patch.object(module, "API_PACING", 0),
        mock.patch.object(module, "API_RETRY_DELAY", 0),
        mock.patch.object(module, "_LAST_REQUEST_TIME", 0.0),
        mock.patch.object(module, "time", mock.Mock(monotonic=time.monotonic,
                                                    sleep=lambda _s: None,
                                                    time=time.time)),
    ]
    if requests_stub is not None:
        patches.append(mock.patch.object(module, "requests", requests_stub))
    if attempts is not None:
        patches.append(mock.patch.object(module, "API_RETRY_ATTEMPTS", attempts))
    with contextlib.ExitStack() as stack:
        for p in patches:
            stack.enter_context(p)
        yield


