def resolve_config_path(required: bool = False) -> str:
    """$MY_BOOX_CONFIG wins outright (the escape hatch for tests and cron),
    otherwise the first existing file in the documented search order."""
    env_path = os.environ.get(CONFIG_ENV_VAR, "").strip()
    if env_path:
        env_path = os.path.expanduser(env_path)
        # Checked here rather than trusted: an env var pointing at a file
        # that isn't there is a mistake worth naming, not a reason to fall
        # through to an empty config and fail later with the much vaguer
        # "no email configured".
        if required and not os.path.isfile(env_path):
            die(
                f"my-boox: ${CONFIG_ENV_VAR} points at a file that does not "
                f"exist: {env_path}",
                206,
            )
        return env_path

    for p in CONFIG_SEARCH_PATHS:
        if os.path.isfile(p):
            return p
    if required:
        die(
            "my-boox: no config found. Searched: " + ", ".join(CONFIG_SEARCH_PATHS) +
            f" (and ${CONFIG_ENV_VAR} is unset)"
            f" -- run 'my-boox --create-config ~/.{CONFIG_NAME}' to create one",
            206,
        )
    return CONFIG_SEARCH_PATHS[0]


def load_config(path: str) -> configparser.ConfigParser:
    config = configparser.ConfigParser()
    if os.path.isfile(path):
        config.read(path)
    if "default" not in config:
        config["default"] = {}
    config["default"].setdefault("email", "")
    config["default"].setdefault("token", "")
    config["default"].setdefault("cloud", DEFAULT_CLOUD)
    config["default"].setdefault("api_pacing_seconds", str(DEFAULT_PACING))
    config["default"].setdefault("api_retry_attempts", str(DEFAULT_RETRY_ATTEMPTS))
    # NOT setdefault-ed: _config_delays needs to see whether the key is
    # genuinely absent, otherwise an existing api_retry_delay_seconds could
    # never be honoured as the fallback.
    config["default"].setdefault("api_timeout_seconds", str(DEFAULT_TIMEOUT))
    config["default"].setdefault("duplicate_check_on_send", "true")
    config["default"].setdefault("send_skip_optional_calls", "false")
    config["default"].setdefault("cache_path", "")
    return config


def _write_file_atomic(path: str, text: str, mode: int = 0o600) -> None:
    """Write via a temp file in the same directory, then rename over the
    target. Both files this tool owns are rewritten while it is mid-flight
    (the config every time a token is refreshed, the cache after every
    delete), and a plain truncate-then-write leaves a zero-length or
    half-written file behind if the run is interrupted there. The rename
    is atomic, so a reader sees either the old file or the new one."""
    parent = os.path.dirname(path) or "."
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=parent,
                               prefix="." + os.path.basename(path) + ".",
                               suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def save_config(path: str, config: configparser.ConfigParser) -> None:
    # 0600: this file holds the account token, which is a full credential
    # for the BOOX account -- anything that can read it can send to and
    # delete from the device.
    buf = io.StringIO()
    config.write(buf)
    _write_file_atomic(path, buf.getvalue(), mode=0o600)


# ---------------------------------------------------------------------------
# Local cache of /neocloud/ contents -- the sole source of truth for `ls`
# and `del`. Keyed by the real neocloud document id.
# ---------------------------------------------------------------------------

def cache_path_for(config_path: str) -> str:
    """'~/.my-boox.conf' -> '~/.my-boox.cache.json'. The config's extension
    is replaced rather than appended to, so the pair reads as two files
    belonging to one tool instead of one long chain of suffixes."""
    base, _ext = os.path.splitext(config_path)
    return base + ".cache.json"


_LEGACY_CACHE_SUFFIX = ".neocloud-cache.json"


def resolve_cache_path(config: configparser.ConfigParser, config_path: str) -> str:
    override = config["default"].get("cache_path", "").strip()
    if override:
        return override

    cache_path = cache_path_for(config_path)
    # One-time migration off the older, longer name. Losing the cache is
    # only a slow re-sync rather than a real problem, but there is no
    # reason to make the user pay for it.
    legacy = config_path + _LEGACY_CACHE_SUFFIX
    if os.path.isfile(legacy) and not os.path.exists(cache_path):
        with contextlib.suppress(OSError):
            os.replace(legacy, cache_path)
    return cache_path


def _cached_session(cache: Cache, cloud: str, token: Optional[str]) -> Optional[Tuple[str, str]]:
    """Return a (uid, session_id) pair persisted by a previous run, or
    None. Keyed by (cloud, token) so a re-auth invalidates it rather than
    reusing a session tied to the old credential."""
    sess: Dict[str, Any] = cache.get("session") or {}
    if (sess.get("cloud") == cloud and sess.get("token_tail") == (token or "")[-8:]
            and sess.get("uid") and sess.get("session_id")):
        if sess.get("expires_at") and time.time() > sess["expires_at"] - 3600:
            return None
        return sess["uid"], sess["session_id"]
    return None


def load_cache(cache_path: str) -> Cache:
    if not os.path.isfile(cache_path):
        return {"last_seq": "0", "docs": {}}
    try:
        with open(cache_path) as f:
            data = json.load(f)
        data.setdefault("last_seq", "0")
        data.setdefault("docs", {})
        return data
    except (ValueError, OSError):
        return {"last_seq": "0", "docs": {}}


def save_cache(cache_path: str, cache: Cache) -> None:
    _write_file_atomic(cache_path, json.dumps(cache, indent=2) + "\n", mode=0o600)


# ---------------------------------------------------------------------------
# API layer
# ---------------------------------------------------------------------------

# Response and request fields that are credentials in their own right.
# 'code' is the emailed verification code, 'token'/'session_id' are the two
# things that authenticate every call this tool makes, and the STS triple
# is a live write capability on the OSS bucket.
_SECRET_KEYS = frozenset({
    "token", "session_id", "code", "sign", "userSig",
    "AccessKeyId", "AccessKeySecret", "SecurityToken",
})


def _redact(obj: Any) -> Any:
    """Mask credential values in anything about to be printed by -D.

    Debug output is the thing that gets redirected to a file and pasted
    into a bug report; unredacted, a single `my-boox -D ls` writes a
    working session_id to disk, and `-D` during a re-auth writes the
    account token itself. Values are replaced with a length marker so the
    output still shows whether a field was present and plausible."""
    if isinstance(obj, dict):
        out: Dict[str, Any] = {}
        for k, v in obj.items():
            if k in _SECRET_KEYS and isinstance(v, str) and v:
                out[k] = f"<redacted {len(v)} chars>"
            elif k == "url" and isinstance(v, str) and "Signature=" in v:
                # Pre-signed OSS URL: the path identifies the file (useful
                # when debugging), the query string is the capability.
                out[k] = v.split("?", 1)[0] + "?<redacted signature>"
            else:
                out[k] = _redact(v)
        return out
    if isinstance(obj, list):
        return [_redact(v) for v in obj]
    return obj


# Credential-bearing query parameters of a pre-signed OSS URL. Matched on
# the serialized text rather than the object tree because the URL is buried
# inside the document's 'content' field, which is itself a JSON-encoded
# STRING -- _redact() walks right past it, so a -D log was still carrying a
# usable signature and the full STS security token (which is also most of
# the log's bulk: ~2.6KB per document).
_SECRET_QUERY_RE = re.compile(
    r"((?:Signature|security-token|OSSAccessKeyId|AccessKeyId|Expires)=)"
    r"[^&\"'\\\s]+",
    re.IGNORECASE,
)


def _mask_url_secrets(text: str) -> str:
    return _SECRET_QUERY_RE.sub(r"\1<redacted>", text)


def _debug_json(obj: Any) -> str:
    """json.dumps for -D output, with credentials masked. Falls back to a
    plain repr if the payload isn't JSON-serializable -- a debug printer
    must never be the thing that raises."""
    try:
        return _mask_url_secrets(json.dumps(_redact(obj), indent=2))
    except (TypeError, ValueError):
        return _mask_url_secrets(repr(obj))


def _get(d: Any, *keys: str) -> Any:
    cur = d
    for k in keys:
        if not isinstance(cur, dict) or k not in cur or cur[k] is None:
            raise BooxAPIError(f"unexpected API response shape (missing '{k}')")
        cur = cur[k]
    return cur


# Populated once in main() from config (api_pacing_seconds/api_retry_attempts/
# api_retry_delay_seconds); these module-level defaults are the fallback for
# any code path that runs before that (there isn't one currently, but keeps
# _paced_request() safe to call regardless of init order).
_api_pacing = DEFAULT_PACING
_api_retry_attempts = DEFAULT_RETRY_ATTEMPTS
_api_retry_delays: Sequence[float] = DEFAULT_RETRY_DELAYS
_api_retry_delays_repeat: Sequence[float] = DEFAULT_RETRY_DELAYS_REPEAT
_api_timeout = DEFAULT_TIMEOUT

_last_request_time = 0.0


def _debug_timing(paced_seconds: float, request_seconds: float, outcome: str) -> None:
    """One line per attempt: how long we chose to wait, how long the server
    took, and what came back. Attributing a slow run needs all three --
    'HTTP 504 after 21.4s' and 'HTTP 504 after 0.2s' mean very different
    things, and neither is the retry backoff that follows."""
    pacing = f"paced {paced_seconds:.1f}s + " if paced_seconds > 0 else ""
    sys.stderr.write(f"    ~ {pacing}server {request_seconds:.2f}s -> {outcome}\n")


def _delay_for_attempt(attempt: int) -> float:
    """Seconds to wait before retry number `attempt` (1-based): the opening
    sequence first, then the repeating one -- 3, 5, 10, 3, 10, 3, 10, ..."""
    opening = _api_retry_delays or DEFAULT_RETRY_DELAYS
    if attempt <= len(opening):
        return opening[attempt - 1]
    repeat = _api_retry_delays_repeat or DEFAULT_RETRY_DELAYS_REPEAT
    return repeat[(attempt - 1 - len(opening)) % len(repeat)]


def _paced_request(method: str, url: str, headers: Optional[Dict[str, str]] = None,
                   params: Optional[Dict[str, Any]] = None, data: Optional[str] = None,
                   timeout: Optional[float] = None, idempotent: bool = True,
                   debug: bool = False) -> Any:
    """Single choke point for every outgoing HTTP request this tool makes --
    both api/1/* (Bearer-authenticated) and /neocloud/* (cookie-
    authenticated) calls route through here. Enforces a minimum pacing
    interval between consecutive requests and retries transient failures
    (connection errors, timeouts, 502/503/504) with backoff before giving
    up. Onyx's backend throws noticeably more of these under back-to-back
    requests -- centralizing this here fixes it for every command (send,
    del, ls) uniformly. Non-transient responses (200, 404, 4xx, etc.) are
    returned as-is on the first try; interpreting them is the caller's job."""
    global _last_request_time
    last_err: Optional[BaseException] = None
    # Clamped: a config with api_retry_attempts = 0 (or a negative) used to
    # skip the loop entirely and fall through to `raise last_err` with
    # last_err still None -- "TypeError: exceptions must derive from
    # BaseException", from a request that was never actually attempted.
    if timeout is None:
        timeout = _api_timeout
    # A request that may have been APPLIED server-side must not be replayed.
    # A 504 means the gateway gave up waiting for the upstream -- it does not
    # mean the upstream did nothing, so re-POSTing saveAndPush could register
    # the same push twice. Reads, and writes that carry an explicit revision
    # (_bulk_docs with new_edits=false, where replaying the same _rev is a
    # no-op), are safe to repeat; nothing else is.
    attempts = max(1, _api_retry_attempts) if idempotent else 1
    for attempt in range(1, attempts + 1):
        paced = 0.0
        if _api_pacing > 0:
            wait = _api_pacing - (time.monotonic() - _last_request_time)
            if wait > 0:
                paced = wait
                time.sleep(wait)
        _last_request_time = time.monotonic()

        # Timed so a slow run can be attributed from the log alone. Without
        # this, "why was that slow" can't be answered: a 504 is an upstream
        # timeout, so the failed attempt itself may cost far more than the
        # backoff that follows it, and the two are indistinguishable.
        started = time.monotonic()
        try:
            resp = requests.request(method, url, headers=headers, params=params,
                                      data=data, timeout=timeout)
        except requests.RequestException as e:
            last_err = e
            if debug:
                _debug_timing(paced, time.monotonic() - started, str(e))
        else:
            if debug:
                _debug_timing(paced, time.monotonic() - started,
                              f"HTTP {resp.status_code}")
            if resp.status_code not in (502, 503, 504):
                return resp
            last_err = BooxAPIError(f"HTTP {resp.status_code} from {url}")

        if attempt < attempts:
            # Always wait before retrying, including the first time.
            # Retrying a hung _changes IMMEDIATELY was tried in v5.2 and
            # measured worse: the immediate attempt hung for another full
            # ~15s and 504'd, and only the one after a ~3s pause answered
            # (in 0.12s). Every fast retry on record had slept first, so the
            # pause is doing the work -- the backend needs a moment, and
            # hammering it straight away just lands in the same state.
            delay = _delay_for_attempt(attempt)
            # Printed unconditionally, not just under -D: a run can sit here
            # for a minute, and the user is entitled to see why and to
            # Ctrl-C out of it rather than stare at a frozen terminal.
            hint = "  (Ctrl-C to stop)" if attempt == 1 else ""
            sys.stderr.write(
                f"my-boox: {last_err} -- attempt {attempt}/{attempts} failed "
                f"after {time.monotonic() - started:.0f}s; "
                f"retrying in {delay:.0f}s...{hint}\n"
            )
            time.sleep(delay)

    if not idempotent:
        raise BooxAPIError(
            f"{url} failed and was NOT retried ({last_err}) -- this call is not "
            f"safe to repeat automatically, because the server may have applied "
            f"it before the gateway gave up. Run 'my-boox ls' to see the real "
            f"state before trying again."
        ) from last_err
    if isinstance(last_err, requests.RequestException):
        raise BooxAPIError(f"network error calling {url}: {last_err}") from last_err
    if last_err is None:  # unreachable: attempts is clamped to >= 1
        raise BooxAPIError(f"no attempt was made for {url}")
    raise last_err


def api_call(cloud: str, token: Optional[str], api_url: str, method: str = "GET",
             headers: Optional[Dict[str, str]] = None, data: Any = None,
             params: Optional[Dict[str, Any]] = None, api: str = "api/1",
             idempotent: bool = True, debug: bool = False) -> Any:
    headers = dict(headers or {})
    body = None

    if token:
        headers["Authorization"] = f"Bearer {token}"

    if data:
        headers["Content-Type"] = "application/json;charset=utf-8"
        method = "POST"
        body = json.dumps(data)

    url = f"https://{cloud}/{api}/{api_url}"
    if debug:
        sys.stderr.write(f">>> {method} {url}\n")
        if params:
            sys.stderr.write(f">>> params: {_debug_json(params)}\n")
        if data:
            sys.stderr.write(f">>> body: {_debug_json(data)}\n")

    resp = _paced_request(method, url, headers=headers, params=params,
                          data=body, idempotent=idempotent, debug=debug)

    try:
        payload = resp.json()
    except ValueError as e:
        raise BooxAPIError(
            f"non-JSON response (HTTP {resp.status_code}) from {api_url}: "
            f"{resp.text[:200]}"
        ) from e

    if debug:
        sys.stderr.write(f"<<< {_debug_json(payload)}\n")

    if isinstance(payload, dict):
        result_code = payload.get("result_code")
        msg = payload.get("message") or f"HTTP {resp.status_code}"
    else:
        result_code = None
        msg = f"HTTP {resp.status_code}"

    # Only a credential-shaped failure may raise BooxAuthError, because
    # that is what triggers the re-auth flow -- which emails a fresh code
    # and blocks on a prompt for it. A 404 or a 400 is a bug or an outage,
    # and no new token will fix either; interrogating the user for a
    # verification code over one is pure noise.
    if resp.status_code in (401, 403):
        raise BooxAuthError(f"{api_url} failed: {msg}")
    if resp.status_code >= 400:
        raise BooxAPIError(f"{api_url} failed: HTTP {resp.status_code}: {msg}")
    # A 200 carrying a nonzero result_code is the shape Onyx uses for an
    # expired/rejected token, so this one stays on the re-auth path.
    if result_code is not None and result_code != 0:
        raise BooxAuthError(f"{api_url} failed: {msg}")

    return payload


def do_request_code(cloud: str, email: str, debug: bool = False) -> None:
    api_call(cloud, None, "users/sendMobileCode", data={"mobi": email},
             idempotent=False, debug=debug)


def do_obtain_token(cloud: str, email: str, code: str, debug: bool = False) -> str:
    payload = api_call(
        cloud, None, "users/signupByPhoneOrEmail",
        data={"mobi": email, "code": code}, idempotent=False, debug=debug,
    )
    return _get(payload, "data", "token")


# Per-process caches for values that provably don't change within a single
# invocation. Keyed by (cloud, token) so a mid-run re-auth (which swaps the
# token) naturally invalidates them rather than reusing stale state.
# This matters a lot: at the default 1.5s pacing, every avoided request is
# 1.5s off the wall clock, and a naive send re-fetched all of these once
# per file.
_UID_CACHE = {}
_SESSION_CACHE = {}
_SESSION_EXPIRES = {}
_BUCKETS_CACHE = {}
_STSS_CACHE = {}


def get_uid(cloud: str, token: Optional[str], debug: bool = False) -> str:
    key = (cloud, token)
    if key not in _UID_CACHE:
        payload = api_call(cloud, token, "users/me", debug=debug)
        _UID_CACHE[key] = _get(payload, "data", "uid")
    return _UID_CACHE[key]


def get_neocloud_cookie(cloud: str, token: Optional[str], debug: bool = False) -> str:
    """The actual device-facing storage is a Couchbase Sync Gateway instance
    at /neocloud/ (confirmed by its CouchDB-style _revs_diff/_bulk_docs/
    _changes API and a 'SyncGatewaySession' cookie), completely separate
    from the Bearer-token-authenticated api/1/* REST layer. users/syncToken
    is itself a normal Bearer-authenticated call that hands back the
    session id the browser then uses as that cookie -- so no browser/login
    flow is needed to obtain it.

    Cached per process: the returned session_id is stable (it carries its
    own multi-week 'expires'), and re-fetching it before every neocloud
    call was costing a full pacing interval each time."""
    key = (cloud, token)
    if key not in _SESSION_CACHE:
        payload = api_call(cloud, token, "users/syncToken", debug=debug)
        _SESSION_CACHE[key] = _get(payload, "data", "session_id")
        raw = (payload.get("data") or {}).get("expires")
        if raw:
            try:
                _SESSION_EXPIRES[key] = calendar.timegm(
                    time.strptime(raw, "%Y-%m-%dT%H:%M:%SZ"))
            except (ValueError, TypeError):
                _SESSION_EXPIRES.pop(key, None)
    return _SESSION_CACHE[key]


def get_buckets(cloud: str, token: Optional[str], debug: bool = False) -> Dict[str, Any]:
    """Static per-account bucket/endpoint config -- cached per process."""
    key = (cloud, token)
    if key not in _BUCKETS_CACHE:
        payload = api_call(cloud, token, "config/buckets", debug=debug)
        _BUCKETS_CACHE[key] = _get(payload, "data", "onyx-cloud")
    return _BUCKETS_CACHE[key]


def get_stss(cloud: str, token: Optional[str], debug: bool = False) -> Dict[str, Any]:
    """Short-lived STS upload credentials. Unlike the others these really do
    expire (the response carries an 'Expiration'), so they're cached only
    until shortly before that, then re-fetched. Falls back to always
    re-fetching if the expiry can't be parsed -- correctness over speed."""
    key = (cloud, token)
    cached = _STSS_CACHE.get(key)
    if cached:
        data, expires_at = cached
        if expires_at is not None and time.time() < expires_at - 300:
            return data

    payload = api_call(cloud, token, "config/stss", debug=debug)
    data = _get(payload, "data")

    expires_at = None
    raw = data.get("Expiration")
    if raw:
        try:
            expires_at = calendar.timegm(
                time.strptime(raw, "%Y-%m-%dT%H:%M:%SZ")
            )
        except (ValueError, TypeError):
            expires_at = None

    _STSS_CACHE[key] = (data, expires_at)
    return data


def prime_session_from_cache(cloud: str, token: Optional[str], cache: Cache) -> None:
    """Seed the in-process uid/session caches from the ones a previous run
    persisted, so a plain 'ls' spends zero requests on users/me and
    users/syncToken. The session carries its own multi-week expiry, and
    _cached_session refuses one that is close to it."""
    hit = _cached_session(cache, cloud, token)
    if hit:
        uid, session_id = hit
        _UID_CACHE.setdefault((cloud, token), uid)
        _SESSION_CACHE.setdefault((cloud, token), session_id)


def store_session_in_cache(cache: Cache, cloud: str, token: Optional[str],
                           uid: str, session_id: str) -> None:
    cache["session"] = {
        "cloud": cloud,
        # Only a tail, so the cache file never carries a usable token.
        "token_tail": (token or "")[-8:],
        "uid": uid,
        "session_id": session_id,
        "expires_at": _SESSION_EXPIRES.get((cloud, token)),
    }


def with_fresh_session(cloud: str, token: Optional[str],
                       fn: Callable[[str], Any], debug: bool = False) -> Any:
    """Run fn(session_id), and if /neocloud/ rejects the session, drop it,
    fetch a new one and retry ONCE. This is what makes persisting the
    session across runs safe: a stale one costs one extra request, not a
    failed command."""
    session_id = get_neocloud_cookie(cloud, token, debug=debug)
    try:
        return fn(session_id)
    except BooxSessionExpired:
        if debug:
            sys.stderr.write(">>> session rejected; fetching a fresh one\n")
        _SESSION_CACHE.pop((cloud, token), None)
        _SESSION_EXPIRES.pop((cloud, token), None)
        return fn(get_neocloud_cookie(cloud, token, debug=debug))


def neocloud_request(cloud: str, session_id: str, method: str, path: str,
                     json_body: Any = None, params: Optional[Dict[str, Any]] = None,
                     idempotent: bool = True, debug: bool = False) -> Any:
    headers = {"Cookie": f"SyncGatewaySession={session_id}"}
    body = None
    if json_body is not None:
        headers["Content-Type"] = "application/json"
        body = json.dumps(json_body)

    url = f"https://{cloud}/neocloud/{path}"
    if debug:
        sys.stderr.write(f">>> {method} {url}\n")
        # Params matter here in a way they do not for api/1: 'since' and
        # 'limit' are what determine how much work the server takes on, so
        # a debug log without them cannot explain a slow _changes.
        if params:
            sys.stderr.write(f">>> params: {_debug_json(params)}\n")
        if json_body is not None:
            sys.stderr.write(f">>> body: {_debug_json(json_body)}\n")

    resp = _paced_request(method, url, headers=headers, params=params,
                          data=body, idempotent=idempotent, debug=debug)

    try:
        result = resp.json()
    except ValueError as e:
        raise BooxAPIError(
            f"non-JSON response (HTTP {resp.status_code}) from neocloud/{path}: "
            f"{resp.text[:200]}"
        ) from e

    if debug:
        sys.stderr.write(f"<<< {_debug_json(result)}\n")

    if resp.status_code in (401, 403):
        raise BooxSessionExpired(
            f"neocloud/{path}: session rejected (HTTP {resp.status_code})")
    if resp.status_code >= 400:
        raise BooxAPIError(f"neocloud/{path} failed: HTTP {resp.status_code}: {result}")

    return result


def neocloud_get_doc(cloud: str, session_id: str, neocloud_id: str,
                     debug: bool = False) -> Optional[Dict[str, Any]]:
    """Plain GET /neocloud/<id> -- returns the full document dict (including
    _rev, name, size, etc.) for a live document, or None if the id doesn't
    exist there (404) -- both for ids that never existed, and for ids that
    were already deleted (a deleted document also 404s on a plain GET,
    indistinguishable from never having existed)."""
    headers = {"Cookie": f"SyncGatewaySession={session_id}"}
    url = f"https://{cloud}/neocloud/{neocloud_id}"
    if debug:
        sys.stderr.write(f">>> GET {url}\n")

    resp = _paced_request("GET", url, headers=headers, debug=debug)

    if resp.status_code == 404:
        if debug:
            sys.stderr.write("<<< 404 (not found)\n")
        return None

    try:
        result = resp.json()
    except ValueError as e:
        raise BooxAPIError(
            f"non-JSON response (HTTP {resp.status_code}) looking up "
            f"neocloud/{neocloud_id}: {resp.text[:200]}"
        ) from e

    if debug:
        sys.stderr.write(f"<<< {_debug_json(result)}\n")

    if resp.status_code in (401, 403):
        raise BooxSessionExpired(
            f"neocloud/{neocloud_id}: session rejected (HTTP {resp.status_code})")
    if resp.status_code >= 400:
        raise BooxAPIError(f"neocloud/{neocloud_id} lookup failed: HTTP {resp.status_code}: {result}")

    return result


def neocloud_delete_doc(cloud: str, session_id: str, neocloud_id: str,
                        current_rev: str, debug: bool = False) -> None:
    """Submit a proper CouchDB/Sync Gateway tombstone for a document we
    know the real current revision of. The new tombstone revision becomes
    start+1 with current_rev's hash as its parent in _revisions. Takes an
    already-fetched session_id rather than a token, so callers that
    already have one (e.g. do_delete_one, which needs one anyway to look
    up the current rev) don't pay for a second redundant users/syncToken
    call."""
    try:
        start, parent_hash = str(current_rev).split("-", 1)
        new_start = int(start) + 1
    except ValueError as e:
        raise BooxAPIError(
            f"cannot delete {neocloud_id}: unparseable revision "
            f"{current_rev!r} (expected '<int>-<hash>')"
        ) from e
    new_hash = uuid.uuid4().hex

    doc = {
        "_deleted": True,
        "_id": neocloud_id,
        "_rev": f"{new_start}-{new_hash}",
        "_revisions": {"start": new_start, "ids": [new_hash, parent_hash]},
    }
    neocloud_request(cloud, session_id, "POST", "_bulk_docs",
                      json_body={"docs": [doc], "new_edits": False}, debug=debug)


def _tombstone_for(neocloud_id: str, current_rev: str) -> Dict[str, Any]:
    """Build one tombstone document. Split out of neocloud_delete_doc so a
    whole batch of them can go in a single _bulk_docs request."""
    try:
        start, parent_hash = str(current_rev).split("-", 1)
        new_start = int(start) + 1
    except ValueError as e:
        raise BooxAPIError(
            f"cannot delete {neocloud_id}: unparseable revision "
            f"{current_rev!r} (expected '<int>-<hash>')"
        ) from e
    new_hash = uuid.uuid4().hex
    return {
        "_deleted": True,
        "_id": neocloud_id,
        "_rev": f"{new_start}-{new_hash}",
        "_revisions": {"start": new_start, "ids": [new_hash, parent_hash]},
    }


def neocloud_delete_many(cloud: str, session_id: str, id_to_rev: Dict[str, str],
                         debug: bool = False) -> None:
    """Tombstone every given document in ONE _bulk_docs request.

    Sync Gateway takes an arbitrary number of docs per _bulk_docs call --
    it is the same request shape the browser uses, just with more entries
    in the list. Deleting them one at a time cost three paced requests per
    file; a batch costs one for the whole set."""
    docs = [_tombstone_for(doc_id, rev) for doc_id, rev in id_to_rev.items()]
    if not docs:
        return

    # The browser sends a _revs_diff before this, but it is a pure CouchDB
    # optimisation ("which of these revisions do you not already have?")
    # with no side effects, and a send/delete round trip verified on the
    # device confirmed the tombstone alone is what removes the file. Not
    # worth a paced request -- during a gateway wobble it is also one more
    # thing to sit through 504 backoff for.
    neocloud_request(cloud, session_id, "POST", "_bulk_docs",
                      json_body={"docs": docs, "new_edits": False}, debug=debug)


def refresh_cache(cloud: str, token: Optional[str], cache_path: str,
                  debug: bool = False) -> Docs:
    """Incrementally sync the local cache with /neocloud/.

    `_changes` is asked for `include_docs=true`, so every changed document
    arrives with its full body (name/size/timestamps) inline. Previously
    this made one `_changes` call and then a separate GET per new or
    changed document -- at the default 1.5s pacing, a first sync over 100
    files was 100 extra round trips, several minutes of pure waiting, for
    data the same response can carry for free.

    The feed is bounded with `limit`, as the browser bounds it, and paged
    through until a short page arrives. An unbounded feed asks the server
    for arbitrarily much work in one request, which is what the gateway
    gives up on. Steady state is still a single request: nothing has
    changed, so the first page is empty and short.

    Sync Gateway's `_bulk_get` would also batch this, but it answers as
    multipart/mixed (a browser capture of it here returned HTTP 406
    "Response is multipart"), so it would need content negotiation and a
    MIME parser to read. `include_docs` needs neither.

    A GET per document remains as a fallback for the case where a change
    arrives without its body, which shouldn't happen but costs one request
    each if it ever does. Returns the up-to-date
    {doc_id: {"name":, "size":, "rev":, "createdAt":, "updatedAt":}} dict."""
    # Loaded first so the uid/session persisted by the previous run can be
    # reused: without this every command spends two paced requests on
    # users/me and users/syncToken before it does anything at all.
    cache = load_cache(cache_path)
    prime_session_from_cache(cloud, token, cache)

    uid = get_uid(cloud, token, debug=debug)
    channel = f"{uid}-MESSAGE"

    def fetch(session_id: str) -> Any:
        return neocloud_request(
            cloud, session_id, "GET", "_changes",
            params={
                "style": "all_docs",
                "filter": "sync_gateway/bychannel",
                "channels": channel,
                "since": cache["last_seq"],
                "include_docs": "true",
                "limit": CHANGES_PAGE_LIMIT,
            },
            debug=debug,
        )

    while True:
        result = with_fresh_session(cloud, token, fetch, debug=debug)
        results = result.get("results", [])
        _apply_changes(cloud, cache, results, token, debug=debug)
        cache["last_seq"] = result.get("last_seq", cache["last_seq"])
        # A short page means we have caught up. A full one means there is
        # more, and the next request resumes from the sequence just stored.
        if len(results) < CHANGES_PAGE_LIMIT:
            break

    session_id = get_neocloud_cookie(cloud, token, debug=debug)
    store_session_in_cache(cache, cloud, token, uid, session_id)
    # Stamped so 'ls --cached' can say how old the answer it is giving is.
    cache["refreshed_at"] = int(time.time())
    save_cache(cache_path, cache)
    return cache["docs"]


def _apply_changes(cloud: str, cache: Cache, results: Sequence[Dict[str, Any]],
                   token: Optional[str], debug: bool = False) -> None:
    """Fold one page of _changes into the cache."""
    session_id = get_neocloud_cookie(cloud, token, debug=debug)
    for r in results:
        doc_id = r.get("id")
        if not doc_id:
            continue
        if r.get("deleted"):
            cache["docs"].pop(doc_id, None)
            continue
        changes = r.get("changes", [])
        if not changes:
            continue

        doc = r.get("doc")
        if doc is None:
            doc = neocloud_get_doc(cloud, session_id, doc_id, debug=debug)
        # A tombstone can arrive as an inline doc with _deleted set rather
        # than the top-level "deleted" flag; both mean the file is gone.
        if not doc or doc.get("_deleted"):
            cache["docs"].pop(doc_id, None)
            continue

        cache["docs"][doc_id] = {
            "name": doc.get("name"),
            "size": doc.get("size"),
            "rev": doc.get("_rev", changes[0]["rev"]),
            "createdAt": doc.get("createdAt"),
            "updatedAt": doc.get("updatedAt"),
        }


def _content_doc(doc_id: str, rev_str: str, revisions: Dict[str, Any], uid: str,
                 basename: str, resource_type: str, remotename: str, size: int,
                 sign_url_fn: Callable[[str], str]) -> Dict[str, Any]:
    """Build one /neocloud/ document in the exact shape the web client
    posts -- verified field-for-field against a HAR of a browser upload.
    Shared by the single and batched write paths so the two cannot drift."""
    now_ms = int(time.time() * 1000)
    content_obj = {
        "_id": doc_id,
        "createdAt": now_ms,
        "distributeChannel": "onyx",
        "formats": [resource_type],
        "guid": doc_id,
        "name": basename,
        "ownerId": uid,
        "size": size,
        "md5": "",
        "storage": {
            resource_type: {
                "oss": {
                    "displayName": basename,
                    "expires": 0,
                    "key": remotename,
                    "provider": "oss",
                    "size": size,
                    "url": sign_url_fn(remotename),
                }
            }
        },
        "title": basename,
        "updatedAt": now_ms,
    }
    doc = {
        "contentType": "digital_content",
        "content": json.dumps(content_obj, separators=(",", ":")),
        "msgType": 2,
        "dbId": f"{uid}-MESSAGE",
        "user": uid,
        "name": basename,
        "size": size,
        "uniqueId": doc_id,
        "createdAt": now_ms,
        "updatedAt": now_ms,
        "_id": doc_id,
        "_rev": rev_str,
        "_revisions": revisions,
    }
    return doc


def send_preamble(cloud: str, token: Optional[str], skip_optional: bool = False,
                  debug: bool = False) -> str:
    """The per-RUN part of a send: getDevice and im/getSig, whose responses
    are both discarded. They exist because the upstream project mirrored
    the web client's call sequence, and the browser makes them once when
    the page loads -- not once per file. Making them per-file cost two
    paced requests for every single file and bought nothing."""
    uid = get_uid(cloud, token, debug=debug)
    if not skip_optional:
        api_call(cloud, token, "users/getDevice", debug=debug)
        api_call(cloud, token, "im/getSig", params={"user": uid}, debug=debug)
    return uid


def upload_one(cloud: str, token: Optional[str], filename: str,
               debug: bool = False) -> Dict[str, Any]:
    """Upload a single file to OSS and return everything needed to write
    its /neocloud/ document later. Splitting the upload from the document
    write is what lets a whole batch of documents go in one _bulk_docs.

    The OSS transfer itself does not go through the paced request layer --
    it is a bulk data transfer to a different host, not an API call."""
    uid = get_uid(cloud, token, debug=debug)

    onyx_cloud = get_buckets(cloud, token, debug=debug)
    bucket_name = onyx_cloud["bucket"]
    endpoint = onyx_cloud["aliEndpoint"]

    stss_data = get_stss(cloud, token, debug=debug)
    access_key_id = stss_data["AccessKeyId"]
    access_key_secret = stss_data["AccessKeySecret"]
    security_token = stss_data["SecurityToken"]

    auth = oss2.StsAuth(access_key_id, access_key_secret, security_token)
    # config/buckets returns a bare hostname, and oss2 defaults a
    # scheme-less endpoint to http:// -- which uploaded the file, and
    # signed the download URL, in cleartext on port 80. The web client
    # uses https for both; force the same here.
    if "://" not in endpoint:
        endpoint = "https://" + endpoint
    bucket = oss2.Bucket(auth, endpoint, bucket_name)

    _, extension = os.path.splitext(filename)
    remotename = f"{uid}/push/{uuid.uuid4()}{extension}"
    oss2.resumable_upload(bucket, remotename, filename)

    basename = os.path.basename(filename)
    resource_type = extension.lstrip(".").lower() or "txt"
    size = os.path.getsize(filename)

    def sign_url_fn(key: str) -> str:
        return bucket.sign_url(
            "GET", key, 3 * 3600,
            params={"response-content-disposition": "attachment"},
        )

    rev1_hash = uuid.uuid4().hex
    return {
        "doc_id": uuid.uuid4().hex,
        "rev": f"1-{rev1_hash}",
        "revisions": {"start": 1, "ids": [rev1_hash]},
        "uid": uid,
        "basename": basename,
        "resource_type": resource_type,
        "remotename": remotename,
        "size": size,
        "bucket_name": bucket_name,
        "sign_url_fn": sign_url_fn,
    }


def finalize_send(cloud: str, token: Optional[str], item: Dict[str, Any],
                  debug: bool = False) -> Tuple[str, str, str, int, Optional[str], Optional[str]]:
    """The api/1 half of a send, once the document is written: one
    saveAndPush per file. Unlike the /neocloud/ write this one cannot be
    batched -- the call carries a single resource."""
    doc_id, final_rev = item["doc_id"], item["rev"]
    basename, remotename = item["basename"], item["remotename"]
    resource_type, bucket_name = item["resource_type"], item["bucket_name"]

    # saveAndPush, with 'cbMsg' naming the document we just wrote.
    #
    # This is the single call that makes my-boox behave like the web UI.
    # The browser posts cbMsg: {id, rev} pointing at its own _bulk_docs
    # write, and the server ADOPTS that document -- its response echoes
    # the same id back. Omitting cbMsg (which is what earlier versions
    # did) makes the server register a second, independent /neocloud/
    # document for the same file instead: hence two rows per file where
    # the browser shows one, and hence a delete that only removed one of
    # them. Same call, one extra field, one document per file.
    # idempotent=False: saveAndPush registers a push each time it is applied.
    # A 504 here means "unknown outcome", not "did nothing".
    result = api_call(
        cloud, token, "push/saveAndPush", idempotent=False,
        data={
            "data": {
                "bucket": bucket_name,
                "name": basename,
                "parent": None,
                "resourceDisplayName": basename,
                "resourceKey": remotename,
                "resourceType": resource_type,
                "title": basename,
            },
            "cbMsg": {"id": doc_id, "rev": final_rev},
        },
        debug=debug,
    )

    # Normally the echo is our own id (adoption worked). Anything else
    # means the server made its own document after all, so report it and
    # let the caller track it too.
    cb_msg = (result.get("data") or {}).get("cbMsg") or {}
    cb_id, cb_rev = cb_msg.get("id"), cb_msg.get("rev")
    if cb_id == doc_id:
        cb_id, cb_rev = None, None

    return doc_id, final_rev, basename, item["size"], cb_id, cb_rev


def write_docs_batch(cloud: str, session_id: str, items: Sequence[Dict[str, Any]],
                     debug: bool = False) -> None:
    """Write every prepared document in ONE _bulk_docs -- the browser sends
    a list too, so a per-file write cost a paced request per file for no
    benefit."""
    if not items:
        return

    # The browser POSTs _revs_diff first, and we did too until it was
    # measured costing 18s of a 28s send (a cold-cache 504 plus its backoff).
    # It is a read-only query -- "which of these revisions do you not already
    # have?" -- whose answer we discard, so it changes nothing and skipping it
    # cannot affect the write. Kept here, commented, because it IS what the
    # browser does: if a future delivery problem ever traces back to this,
    # put it back first.
    #     revs_diff_body = {item["doc_id"]: [item["rev"]] for item in items}
    #     neocloud_request(cloud, session_id, "POST", "_revs_diff",
    #                      json_body=revs_diff_body, debug=debug)
    docs = [
        _content_doc(item["doc_id"], item["rev"], item["revisions"], item["uid"],
                     item["basename"], item["resource_type"], item["remotename"],
                     item["size"], item["sign_url_fn"])
        for item in items
    ]

    try:
        neocloud_request(cloud, session_id, "POST", "_bulk_docs",
                         json_body={"docs": docs, "new_edits": False}, debug=debug)
    except (BooxAPIError, BooxAuthError) as e:
        raise BooxAPIError(
            f"neocloud delivery write failed: {e} -- nothing was "
            f"registered or delivered, safe to just retry 'send'"
        ) from e


# ---------------------------------------------------------------------------
# Re-auth wrapper
# ---------------------------------------------------------------------------

def with_reauth(action: Callable[[Optional[str]], Any],
                config: configparser.ConfigParser, config_path: str,
                debug: bool = False) -> Any:
    """Run action(token) with the stored token. On BooxAuthError, request a
    fresh verification code, prompt for it, obtain a new token, save it, and
    retry once. Raises SystemExit on any unrecoverable failure."""

    token = config["default"].get("token") or None

    try:
        return action(token)
    except BooxAuthError as e:
        if debug:
            sys.stderr.write(f"my-boox: first attempt failed: {e}\n")

        email = config["default"].get("email", "")
        if not email:
            die(
                "my-boox: no email configured -- run 'my-boox --create-config' "
                "and fill in 'email'",
                205,
            )
        cloud = config["default"].get("cloud") or DEFAULT_CLOUD

        # Checked BEFORE requesting a code: the re-auth flow blocks on
        # input(), so under cron or any other non-tty caller it would
        # otherwise burn a real verification code and then die on EOFError
        # with a traceback instead of a diagnosis.
        if not sys.stdin.isatty():
            die(
                "my-boox: token rejected and stdin is not a terminal -- re-auth "
                "needs to prompt for the emailed code. Run 'my-boox ls' by hand "
                "once to refresh the token, then re-run this.",
                205,
            )

        sys.stderr.write("my-boox: auth failed, requesting a fresh verification code...\n")
        try:
            do_request_code(cloud, email, debug=debug)
        except (BooxAuthError, BooxAPIError) as e2:
            die(f"my-boox: requesting verification code failed: {e2}", 205)
        sys.stderr.write("Code for token requested. Check email.\n")

        code = input(f"Check {email} for the 6-digit code, then enter it: ").strip()
        if not code:
            die("my-boox: no code entered, aborting", 205)

        try:
            new_token = do_obtain_token(cloud, email, code, debug=debug)
        except (BooxAuthError, BooxAPIError) as e2:
            die(f"my-boox: obtaining token failed: {e2}", 205)

        config["default"]["token"] = new_token
        save_config(config_path, config)

        try:
            return action(new_token)
        except BooxAuthError as e2:
            die(f"my-boox: still failing after re-auth retry: {e2}", 204)


# ---------------------------------------------------------------------------
# Command handlers
# ---------------------------------------------------------------------------

def cmd_send(config: configparser.ConfigParser, config_path: str,
             filenames: Sequence[str], debug: bool = False) -> None:
    cloud = config["default"].get("cloud") or DEFAULT_CLOUD
    cache_path = resolve_cache_path(config, config_path)
    missing = []   # never existed locally -- exit 202
    failed = []    # tried and failed -- exit 204
    uploaded = []  # in OSS, awaiting the batched /neocloud/ write

    check_duplicates = _config_bool(config, "duplicate_check_on_send", True)
    skip_optional = _config_bool(config, "send_skip_optional_calls", False)

    existing = set()
    if check_duplicates:
        def fetch_existing(token: Optional[str]) -> Any:
            return refresh_cache(cloud, token, cache_path, debug=debug)

        try:
            docs = with_reauth(fetch_existing, config, config_path, debug=debug) or {}
        except (BooxAPIError, BooxAuthError) as e:
            sys.stderr.write(f"my-boox: duplicate check failed, continuing without it: {e}\n")
            docs = {}
        for meta in docs.values():
            name, size = meta.get("name"), meta.get("size")
            if name is not None and size is not None:
                # _as_int for the same reason group_docs needs it: a
                # server-side "42" must match a local getsize() 42, or the
                # duplicate check silently never fires.
                existing.add((str(name), _as_int(size)))

    # Once per run, not once per file -- and lazily, so a run where every
    # file turns out to be missing or a duplicate spends no requests at all.
    preamble_done = []

    def run_preamble_once() -> Any:
        if preamble_done:
            return
        preamble_done.append(True)

        def preamble(token: Optional[str]) -> Any:
            return send_preamble(cloud, token, skip_optional=skip_optional,
                                 debug=debug)

        try:
            with_reauth(preamble, config, config_path, debug=debug)
        except (BooxAPIError, BooxAuthError) as e:
            sys.stderr.write(f"my-boox: preflight call failed, continuing: {e}\n")

    for raw_filename in filenames:
        filename = os.path.abspath(os.path.expanduser(raw_filename))
        if not os.path.isfile(filename):
            sys.stderr.write(f"my-boox: file not found: {filename}\n")
            missing.append(raw_filename)
            continue

        basename = os.path.basename(filename)
        try:
            size = os.path.getsize(filename)
        except OSError as e:
            sys.stderr.write(f"my-boox: cannot read {basename}: {e}\n")
            failed.append(raw_filename)
            continue
        if check_duplicates and (basename, size) in existing:
            print(f"skipped: {basename} (already present, same name and size)")
            continue

        run_preamble_once()

        # Batching moved every OSS transfer ahead of the first saveAndPush,
        # so nothing was printed until all of them finished -- a 14-file
        # batch sat silent for a minute. Announce each one as it starts.
        pending = len(filenames) - len(missing) - len(failed) - len(uploaded)
        print(f"uploading: {basename} ({len(uploaded) + 1}/{pending + len(uploaded)})",
              flush=True)

        def upload_action(token: Optional[str], filename: Any = filename) -> Any:
            return upload_one(cloud, token, filename, debug=debug)

        try:
            item = with_reauth(upload_action, config, config_path, debug=debug)
        except (BooxAPIError, BooxAuthError) as e:
            sys.stderr.write(f"my-boox: failed to upload {basename}: {e}\n")
            failed.append(raw_filename)
            continue
        except Exception as e:
            # oss2 raises its own exception hierarchy for a failed upload
            # (and OSError surfaces for a file that vanishes mid-read).
            # Neither is a BooxError, so an unhandled one used to abort the
            # whole batch at the first bad file -- exactly the opposite of
            # the documented "the rest of the batch is still attempted".
            # SystemExit is a BaseException, so a genuine re-auth failure
            # still stops the run rather than being swallowed here.
            if debug:
                raise
            sys.stderr.write(
                f"my-boox: failed to upload {basename}: {type(e).__name__}: {e}\n"
            )
            failed.append(raw_filename)
            continue

        item["raw_filename"] = raw_filename
        uploaded.append(item)
        if check_duplicates:
            existing.add((basename, size))

    # One _revs_diff + one _bulk_docs for the whole batch, then the api/1
    # half per file. Nothing is registered or delivered until this runs, so
    # a failure here means every uploaded file failed together -- the OSS
    # objects are orphaned but harmless, and re-running 'send' is safe.
    if uploaded:
        def write_batch(token: Optional[str]) -> Any:
            session_id = get_neocloud_cookie(cloud, token, debug=debug)
            write_docs_batch(cloud, session_id, uploaded, debug=debug)

        try:
            with_reauth(write_batch, config, config_path, debug=debug)
        except (BooxAPIError, BooxAuthError) as e:
            sys.stderr.write(f"my-boox: {e}\n")
            die(
                f"my-boox: {len(uploaded)} of {len(filenames)} failed: " +
                ", ".join(item["raw_filename"] for item in uploaded),
                204,
            )

    for item in uploaded:
        basename, raw_filename = item["basename"], item["raw_filename"]

        def finalize_action(token: Optional[str], item: Any = item) -> Any:
            return finalize_send(cloud, token, item, debug=debug)

        try:
            result = with_reauth(finalize_action, config, config_path, debug=debug)
        except (BooxAPIError, BooxAuthError) as e:
            sys.stderr.write(f"my-boox: failed to send {basename}: {e}\n")
            failed.append(raw_filename)
            continue

        print(f"sent: {basename}")

        if result:
            doc_id, rev, name, doc_size, cb_id, cb_rev = result
            # Stamped with the real send time rather than None: 'ls' sorts
            # newest-first on this, and a None sorted a just-sent file to
            # the bottom of the list until the next full refresh.
            now_ms = int(time.time() * 1000)
            cache = load_cache(cache_path)
            cache["docs"][doc_id] = {
                "name": name, "size": doc_size, "rev": rev,
                "createdAt": now_ms, "updatedAt": now_ms,
            }
            # Only set when the server declined to adopt our document and
            # made its own anyway; grouped with the above by (name, size)
            # so 'ls' still shows one row and 'del' removes both.
            if cb_id and cb_rev:
                cache["docs"][cb_id] = {
                    "name": name, "size": doc_size, "rev": cb_rev,
                    "createdAt": now_ms, "updatedAt": now_ms,
                }
            save_cache(cache_path, cache)

    problems = missing + failed
    if problems:
        die(
            f"my-boox: {len(problems)} of {len(filenames)} failed: " +
            ", ".join(problems),
            204 if failed else 202,
        )


def _as_int(value: Any, default: int = 0) -> int:
    """Coerce a /neocloud/ numeric field to a real int.

    Sizes and createdAt/updatedAt timestamps come back as a JSON number
    for some documents and as a decimal STRING for others, in the same
    _changes batch. Both fields are used for ordering, grouping and
    ':n' formatting, all of which raise TypeError/ValueError the moment a
    str sneaks in. Anything unparseable becomes `default`."""
    if value is None or isinstance(value, bool):
        return default
    if isinstance(value, int):
        return value
    if isinstance(value, float):
        return int(value)
    if isinstance(value, str):
        try:
            return int(float(value.strip()))
        except ValueError:
            return default
    return default


def group_docs(docs: Docs) -> List[Dict[str, Any]]:
    """Collapse the several /neocloud/ documents that make up ONE logical
    file into a single entry.

    Current sends produce exactly one document per file (saveAndPush is
    given a 'cbMsg' naming our own write, so the server adopts it instead
    of registering its own). Grouping still matters for what is already
    in the account: every file sent before that fix has a leftover second
    document, and both must be deleted for the file to really go away.

    Grouping key is (name, size), the same pair 'send' already uses for
    its duplicate check. Two genuinely distinct files with identical name
    AND size would be merged into one entry -- rare, and deleting one of
    those would almost certainly mean wanting both gone anyway.

    Returns [{"id":, "ids": [...], "name":, "size":, "sort_key":}, ...]
    where 'id' is the one to display and 'ids' is every underlying
    document that must be deleted to really remove the file."""
    groups = {}
    for doc_id, meta in docs.items():
        name, size = meta.get("name"), meta.get("size")
        if name is None or size is None:
            continue
        name = str(name)
        # Normalized before it is used as part of the grouping key, so a
        # server-side "42" and a local os.path.getsize() 42 land in the
        # same group rather than showing up as two rows for one file.
        size = _as_int(size)
        key = (name, size)
        stamp = _as_int(meta.get("updatedAt")) or _as_int(meta.get("createdAt"))
        g = groups.setdefault(key, {"ids": [], "name": name, "size": size,
                                     "sort_key": 0})
        g["ids"].append(doc_id)
        if stamp > g["sort_key"]:
            g["sort_key"] = stamp

    out = []
    for g in groups.values():
        g["ids"].sort()
        g["id"] = g["ids"][0]
        out.append(g)
    out.sort(key=lambda g: g["sort_key"], reverse=True)
    return out


def _describe_age(seconds: Optional[int]) -> str:
    if seconds is None:
        return "age unknown"
    if seconds < 90:
        return f"{seconds}s old"
    if seconds < 5400:
        return f"{seconds // 60}m old"
    if seconds < 172800:
        return f"{seconds // 3600}h old"
    return f"{seconds // 86400}d old"


def cmd_ls(config: configparser.ConfigParser, config_path: str,
           debug: bool = False, cached: bool = False) -> List[Dict[str, Any]]:
    """List files. Normally refreshes from /neocloud/ first; with cached=True
    it prints the local mirror and makes no request at all.

    The web client behaves like the cached mode by default -- it paints from
    its local PouchDB replica and syncs afterwards, which is why it feels
    instant and also why it will happily show an empty list for an account
    that has files. Here that is opt-in, and the output says how stale it
    might be."""
    cloud = config["default"].get("cloud") or DEFAULT_CLOUD
    cache_path = resolve_cache_path(config, config_path)

    if cached:
        cache = load_cache(cache_path)
        docs = cache["docs"]
        refreshed_at = cache.get("refreshed_at")
        age = int(time.time()) - int(refreshed_at) if refreshed_at else None
        # stderr, so a piped table stays clean
        sys.stderr.write(
            f"my-boox: showing the local cache ({_describe_age(age)}), no "
            f"request made -- run 'my-boox ls' for the authoritative list\n"
        )
    else:
        def action(token: Optional[str]) -> Any:
            return refresh_cache(cloud, token, cache_path, debug=debug)

        docs = with_reauth(action, config, config_path, debug=debug) or {}

    groups = group_docs(docs)

    # I would expect LC_ALL to be set but it may not be (kept from upstream,
    # affects the ':>Nn' locale-aware digit grouping below)
    try:
        current_locale = locale.getlocale()[0] or "C"
        locale.setlocale(locale.LC_ALL, current_locale)
    except locale.Error:
        pass

    id_width = max([len(g["id"]) for g in groups] + [len("ID")])
    size_width = 10
    name_width = max([len(g["name"]) for g in groups] + [len("Name")])

    print(f"{'ID':<{id_width}} | {'Size':>{size_width}} | Name")
    print("-" * id_width + "-|-" + "-" * size_width + "-|-" + "-" * name_width)
    for g in groups:
        print(f"{g['id']:<{id_width}} | {g['size']:>{size_width}n} | {g['name']}")

    return groups


def do_delete_batch(cloud: str, token: Optional[str], doc_ids: Sequence[str],
                    known_revs: Dict[str, str],
                    debug: bool = False) -> Tuple[List[str], List[str]]:
    """Delete any number of files in a FIXED number of requests, the same
    way the web UI does it: tombstone the /neocloud/ documents, then tell
    the api/1 side about them.

    Both halves are required. The tombstone removes the file from
    /neocloud/; batchDelete removes the push-message record it is paired
    with. Doing only the first is why a deleted file could linger.

    Both halves also take a whole batch at once -- _bulk_docs has always
    accepted a list of docs, and batchDelete's field is literally 'ids' --
    so N files cost two requests, not 2N. Revisions come from the caller
    (one _changes refresh covers every document); only an id that refresh
    didn't see costs an individual GET.

    Returns (deleted_ids, not_found_ids)."""
    session_id = get_neocloud_cookie(cloud, token, debug=debug)

    id_to_rev = {}
    not_found = []
    for doc_id in doc_ids:
        rev = known_revs.get(doc_id)
        if not rev:
            doc = neocloud_get_doc(cloud, session_id, doc_id, debug=debug)
            rev = doc.get("_rev") if doc else None
        if rev:
            id_to_rev[doc_id] = rev
        else:
            not_found.append(doc_id)

    if id_to_rev:
        neocloud_delete_many(cloud, session_id, id_to_rev, debug=debug)
        api_call(cloud, token, "push/message/batchDelete",
                 data={"ids": list(id_to_rev)}, debug=debug)

    return list(id_to_rev), not_found


def cmd_del(config: configparser.ConfigParser, config_path: str,
            ids: Sequence[str], debug: bool = False) -> None:
    cloud = config["default"].get("cloud") or DEFAULT_CLOUD
    cache_path = resolve_cache_path(config, config_path)

    # One refresh up front, which costs a single _changes request and
    # gives the CURRENT revision of every document. That is what makes the
    # batched tombstone below safe: writing a stale revision with
    # new_edits=false would fork the document rather than delete it, so
    # the revisions have to be fresh, and fetching them one GET at a time
    # was the old cost. It also means an id that no longer exists is known
    # to be gone without spending a request on it.
    def refresh(token: Optional[str]) -> Any:
        return refresh_cache(cloud, token, cache_path, debug=debug)

    try:
        cached_docs = with_reauth(refresh, config, config_path, debug=debug) or {}
    except (BooxAPIError, BooxAuthError) as e:
        sys.stderr.write(
            f"my-boox: could not refresh before deleting ({e}); "
            f"falling back to the last known revisions\n"
        )
        cached_docs = load_cache(cache_path)["docs"]

    # Each logical file may be backed by more than one /neocloud/ document
    # (anything sent before v4.0 has a stray second one -- see group_docs).
    # Deleting only the id shown by 'ls' would leave the sibling behind, so
    # expand every requested id into its whole group first. Ids not present
    # in the cache fall through unexpanded and are attempted as-is.
    id_to_group = {}
    for g in group_docs(cached_docs):
        for member in g["ids"]:
            id_to_group[member] = g["ids"]

    targets = []
    for requested in ids:
        for member in id_to_group.get(requested, [requested]):
            if member not in targets:
                targets.append(member)

    extra = len(targets) - len(ids)
    if extra > 0:
        print(f"note: expanded {len(ids)} id(s) to {len(targets)} underlying "
              f"document(s) -- each file is backed by more than one")

    known_revs = {doc_id: meta.get("rev")
                  for doc_id, meta in cached_docs.items() if meta.get("rev")}

    def action(token: Optional[str]) -> Any:
        return do_delete_batch(cloud, token, targets, known_revs, debug=debug)

    try:
        deleted, untracked = with_reauth(action, config, config_path, debug=debug)
    except (BooxAPIError, BooxAuthError) as e:
        sys.stderr.write(f"my-boox: failed to delete: {e}\n")
        die(f"my-boox: none of the {len(targets)} document(s) were deleted", 204)

    cache = load_cache(cache_path)
    for doc_id in deleted + untracked:
        cache["docs"].pop(doc_id, None)
    save_cache(cache_path, cache)

    for doc_id in deleted:
        print(f"deleted: {doc_id}")
    for doc_id in untracked:
        print(f"not found: {doc_id} (already gone, or never existed)")

    if untracked:
        print(
            "note: no live document found for " + ", ".join(untracked) +
            " -- genuinely ambiguous between already-deleted (common if "
            "re-running del on the same id) and never having existed."
        )


