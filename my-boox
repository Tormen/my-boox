            return {}

        with tempfile.TemporaryDirectory() as tmpdir:
            sample = os.path.join(tmpdir, "report.pdf")
            with open(sample, "w") as handle:
                handle.write("x" * 11)

            with mock.patch.object(module, "api_call", side_effect=fake_api_call), \
                 mock.patch.object(module, "get_uid", return_value="uid1"), \
                 mock.patch.object(module, "get_neocloud_cookie", return_value="sess"), \
                 mock.patch.object(module, "get_buckets",
