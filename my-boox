        with _no_pacing(module, stub, attempts=3):
            resp = _paced_request("GET", "https://example.invalid/x")
        self.assertEqual(resp.status_code, 200)
        self.assertEqual(len(stub.calls), 3)

    def test_exhausted_retries_raise_booxapierror_not_typeerror(self) -> None:
        module = sys.modules[__name__]
