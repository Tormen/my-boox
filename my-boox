    def test_404_is_not_treated_as_an_auth_failure(self) -> None:
        # A 404 used to raise BooxAuthError, which made the tool email a
        # verification code and block on a prompt for something no new
        # token could ever fix.
        module = sys.modules[__name__]
        stub = _FakeRequests([_FakeResponse(404, {"message": "not found"})])
        with _no_pacing(module, stub, attempts=1):
            with self.assertRaises(BooxAPIError):
                api_call("example.invalid", "tok", "push/whatever")

    def test_401_and_nonzero_result_code_still_trigger_reauth(self) -> None:
        module = sys.modules[__name__]
        stub = _FakeRequests([_FakeResponse(401, {"message": "token expired"})])
        with _no_pacing(module, stub, attempts=1):
            with self.assertRaises(BooxAuthError):
                api_call("example.invalid", "tok", "users/me")

        stub = _FakeRequests([_FakeResponse(200, {"result_code": 1005,
                                                  "message": "invalid token"})])
        with _no_pacing(module, stub, attempts=1):
            with self.assertRaises(BooxAuthError):
                api_call("example.invalid", "tok", "users/me")

    # -- `my-boox -D ls 2>debug.log` wrote a live session_id to disk in
    #    cleartext; a -D re-auth wrote the account token itself.
    def test_debug_output_redacts_credentials(self) -> None:
        module = sys.modules[__name__]
        payload = {
            "result_code": 0,
            "data": {"session_id": "6f798b02cede2dda45a6f3fe343be49a65f0e320",
                     "token": "live-account-token",
                     "AccessKeySecret": "sts-secret"},
        }
        stub = _FakeRequests([_FakeResponse(200, payload)])
        stderr = io.StringIO()
        with _no_pacing(module, stub, attempts=1), \
             contextlib.redirect_stderr(stderr):
            api_call("example.invalid", "tok", "users/syncToken",
                     data={"code": "123456"}, debug=True)

        out = stderr.getvalue()
        for secret in ("6f798b02cede2dda45a6f3fe343be49a65f0e320",
                       "live-account-token", "sts-secret", "123456"):
            self.assertNotIn(secret, out)
        self.assertIn("redacted", out)
        self.assertIn("users/syncToken", out)  # still useful for debugging

    # -- the signed OSS URL lives inside the document's 'content' field,
    #    which is a JSON-encoded STRING. _redact walks past it, so a -D log
    #    still carried a usable signature and the whole STS security token.
    def test_debug_masks_signed_url_buried_in_a_json_string_field(self) -> None:
        signed = ("https://onyx-cloud.oss.example/uid/push/f.txt"
                  "?response-content-disposition=attachment"
                  "&security-token=STSTOKENVALUE123"
                  "&OSSAccessKeyId=STS.KEYID999"
                  "&Expires=1785979285"
                  "&Signature=SIGVALUE%3D")
        payload = {"results": [{"doc": {
            "name": "f.txt",
            # Exactly how it arrives: a stringified JSON blob.
            "content": json.dumps({"name": "f.txt",
                                   "storage": {"txt": {"oss": {"url": signed}}}}),
        }}]}

        out = _debug_json(payload)
        for secret in ("STSTOKENVALUE123", "STS.KEYID999", "SIGVALUE"):
            self.assertNotIn(secret, out)
        # Still readable: the filename and the object path survive.
        self.assertIn("f.txt", out)
        self.assertIn("uid/push/f.txt", out)

    def test_redaction_keeps_signed_url_path_but_drops_signature(self) -> None:
        redacted = _redact({"url": "https://oss.example/u/push/f.pdf"
                                   "?Expires=1&OSSAccessKeyId=k&Signature=abc123"})
        self.assertIn("f.pdf", redacted["url"])
        self.assertNotIn("abc123", redacted["url"])

    # -- an oss2 upload error is not a BooxError, so it used to escape
    #    cmd_send and abort the whole batch at the first bad file.
    def test_send_continues_batch_after_a_non_boox_upload_error(self) -> None:
        module = sys.modules[__name__]
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = os.path.join(tmpdir, "my-boox.ini")
            config = load_config(config_path)
            config["default"]["duplicate_check_on_send"] = "false"

            paths = []
            for name in ("bad.pdf", "good.pdf"):
                p = os.path.join(tmpdir, name)
                with open(p, "w") as handle:
                    handle.write(name)
                paths.append(p)

            class _OssError(Exception):
                pass

            def flaky_upload(cloud: Any, token: Any, filename: Any, **kwargs: Any) -> Any:
                if filename.endswith("bad.pdf"):
                    raise _OssError("RequestError: connection aborted")
                return _fake_item("doc-good", "1-g", "good.pdf", 8)

            with mock.patch.object(module, "with_reauth",
                                   side_effect=_run_action), \
                 mock.patch.object(module, "send_preamble"), \
                 mock.patch.object(module, "get_neocloud_cookie", return_value="sess"), \
                 mock.patch.object(module, "write_docs_batch"), \
                 mock.patch.object(module, "finalize_send",
                                   return_value=("doc-good", "1-g", "good.pdf", 8, "cb-good", "1-cbg")), \
                 mock.patch.object(module, "upload_one", side_effect=flaky_upload):
                stdout, stderr = io.StringIO(), io.StringIO()
                with contextlib.redirect_stdout(stdout), \
                     contextlib.redirect_stderr(stderr), \
                     self.assertRaises(SystemExit) as ctx:
                    cmd_send(config, config_path, paths, debug=False)

            # The good file still went, and the exit code reports the bad one.
            self.assertIn("sent: good.pdf", stdout.getvalue())
            self.assertIn("failed to upload bad.pdf", stderr.getvalue())
            self.assertEqual(ctx.exception.code, 204)
            self.assertIn("doc-good", load_cache(resolve_cache_path(config, config_path))["docs"])

