def _get_git_commit() -> Optional[str]:
    script_dir = os.path.dirname(os.path.realpath(__file__))
    try:
        result = subprocess.run(
            ["git", "-C", script_dir, "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0:
            return None
        commit = result.stdout.strip()
        dirty = subprocess.run(
            ["git", "-C", script_dir, "status", "--porcelain"],
            capture_output=True, text=True, timeout=5,
        )
        if dirty.returncode == 0 and dirty.stdout.strip():
            commit += "-dirty"
        return commit
    except (OSError, subprocess.SubprocessError):
        return None


class BooxAuthError(Exception):
    """Raised when the API call fails due to an invalid/expired token or
    a rejected credential exchange (HTTP 4xx/5xx, or a nonzero result_code).
    Triggers the automatic re-auth flow."""


class BooxAPIError(Exception):
    """Raised for anything else that goes wrong talking to the API (bad
    JSON, an unexpected response shape). Not auto-retried."""


class BooxSessionExpired(BooxAPIError):
    """Raised when /neocloud/ rejects the SyncGatewaySession cookie.

    Deliberately NOT a BooxAuthError: the account token is fine, only the
    sync-gateway session is stale, and a new one is a single
    users/syncToken call away. Treating it as an auth failure would send
    the user a verification code and block on a prompt for no reason."""


