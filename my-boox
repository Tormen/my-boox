# Command handlers
# ---------------------------------------------------------------------------

def _send_with_retries(do_it, basename, attempts=SEND_RETRY_ATTEMPTS,
                         base_delay=SEND_RETRY_BASE_DELAY):
    """Retry a few times with backoff before giving up. Every failure seen
    in practice sending real batches (502/504 from nginx, read timeouts)
    has been transient backend flakiness under back-to-back requests, not
    a real problem with any individual request -- so it's worth a few
    automatic retries rather than immediately marking the file as failed."""
    last_err = None
    for attempt in range(1, attempts + 1):
        try:
            return do_it()
        except (BooxAPIError, BooxAuthError) as e:
            last_err = e
            if attempt < attempts:
                delay = base_delay * attempt
                sys.stderr.write(
                    f"my-boox: {basename} failed (attempt {attempt}/{attempts}): "
                    f"{e}\nmy-boox: retrying in {delay:.0f}s...\n"
                )
                time.sleep(delay)
    raise last_err


def cmd_send(config, config_path, filenames, debug=False):
    cloud = config["default"].get("cloud") or DEFAULT_CLOUD
    state = load_state(config_path)
    failures = []

    pacing = _config_float(config, "send_pacing_seconds", SEND_BATCH_PACING)
    retry_attempts = _config_int(config, "send_retry_attempts", SEND_RETRY_ATTEMPTS)
    retry_delay = _config_float(config, "send_retry_delay_seconds", SEND_RETRY_BASE_DELAY)
    check_duplicates = _config_bool(config, "duplicate_check_on_send", True)

    existing = set()
    if check_duplicates:
        def fetch_existing(token):
            return _fetch_push_list(cloud, token, debug=debug)

        existing_entries = with_reauth(fetch_existing, config, config_path, debug=debug) or []
        for entry in existing_entries:
            args = entry.get("data", {}).get("args", {})
            name, size = args.get("name"), args.get("size")
            if name is not None and size is not None:
                existing.add((name, size))

    multi = len(filenames) > 1

    for i, raw_filename in enumerate(filenames):
        filename = os.path.abspath(os.path.expanduser(raw_filename))
        if not os.path.isfile(filename):
            sys.stderr.write(f"my-boox: file not found: {filename}\n")
            failures.append(raw_filename)
            continue

        basename = os.path.basename(filename)
        size = os.path.getsize(filename)
        if check_duplicates and (basename, size) in existing:
            print(f"skipped: {basename} (already present, same name and size)")
            continue

        def action(token, filename=filename):
            return do_send(cloud, token, filename, debug=debug)

        def do_it():
            return with_reauth(action, config, config_path, debug=debug)

        try:
            result = _send_with_retries(do_it, basename, attempts=retry_attempts,
                                          base_delay=retry_delay)
        except (BooxAPIError, BooxAuthError) as e:
            sys.stderr.write(f"my-boox: failed to send {basename} after retries: {e}\n")
            failures.append(raw_filename)
            continue

        print(f"sent: {basename}")
        if check_duplicates:
            existing.add((basename, size))

        if result:
            api1_id, neocloud_id, neocloud_rev = result
            if api1_id and neocloud_id and neocloud_rev:
                state[api1_id] = {"neocloud_id": neocloud_id, "rev": neocloud_rev}
                save_state(config_path, state)

        # pace requests in a multi-file batch -- back-to-back requests
        # appear to trigger more 502/504s from Onyx's backend
        if multi and i < len(filenames) - 1:
            time.sleep(pacing)

    if failures:
        die(
            f"my-boox: {len(failures)} of {len(filenames)} failed: " +
            ", ".join(failures),
            204,
        )


def cmd_ls(config, config_path, debug=False):
    cloud = config["default"].get("cloud") or DEFAULT_CLOUD

    def action(token):
        return do_list(cloud, token, debug=debug)

    with_reauth(action, config, config_path, debug=debug)


def cmd_del(config, config_path, ids, debug=False):
    cloud = config["default"].get("cloud") or DEFAULT_CLOUD
    state = load_state(config_path)

    def action(token):
        return do_delete(cloud, token, ids, state, debug=debug)

    untracked = with_reauth(action, config, config_path, debug=debug)

    for _id in ids:
        state.pop(_id, None)
    save_state(config_path, state)

    print("deleted: " + ", ".join(ids))
    if untracked:
        print(
            "note: no tracked neocloud revision for " + ", ".join(untracked) +
            " (sent before this feature existed, or via the website) -- "
            "only the legacy account-listing delete ran for these; they "
            "may still be on the device. Use the BOOXDrop web UI's trash "
            "icon for those."
        )
    print("(run 'my-boox ls' separately to confirm -- the list can lag "
          "briefly right after a delete)")


