# Defaults for the config keys above -- also used as load_config()'s
# fallback values, so the template and the actual defaults can't drift
# apart.
DEFAULT_PACING = 1.5      # seconds between requests
# 5 rather than 3: the gateway 504s at random, and a run was observed
# losing three consecutive attempts on the same request that a neighbouring
# run answered in 0.12s. Each lost attempt costs ~15s, so this trades a
# longer worst case for far fewer outright failures.
DEFAULT_RETRY_ATTEMPTS = 5
# 3s, 5s, 10s to open, then 3s, 10s repeating: 3, 5, 10, 3, 10, 3, 10, ...
# A failed attempt already costs ~15s of gateway hang, so an ever-growing
# backoff mostly adds waiting on top of that. Alternating a short and a long
# pause keeps giving the backend both kinds of gap without the total running
# away (retrying instantly was measured to just hang again).
DEFAULT_RETRY_DELAYS = (3.0, 5.0, 10.0)
DEFAULT_RETRY_DELAYS_REPEAT = (3.0, 10.0)
# Must stay LONGER than the gateway's own ~15s timeout. When
# /neocloud/_changes misses its server-side cache (reliably the first read
# after a write) nginx hangs ~15s, returns 504, and an immediate retry then
# answers in ~0.13s -- the 504 itself is what marks the work as finished.
# Hanging up first was measured and is strictly worse: the upstream keeps
# grinding, every retry hits the same cold cache, and the call fails outright
# after burning the full retry budget.
DEFAULT_TIMEOUT = 30.0


def _config_float(config: configparser.ConfigParser, key: str, default: float) -> float:
    try:
        return config["default"].getfloat(key, fallback=default)
    except ValueError:
        return default


def _config_int(config: configparser.ConfigParser, key: str, default: int) -> int:
    try:
        return config["default"].getint(key, fallback=default)
    except ValueError:
        return default


def _config_delays(config: configparser.ConfigParser, key: str,
                   default: Sequence[float],
                   legacy_key: str = "") -> Sequence[float]:
    """Parse a comma-separated list of seconds. `legacy_key` names an older
    single-value setting to fall back on, so an existing config keeps
    working."""
    raw = config["default"].get(key, "").strip()
    if not raw:
        legacy = config["default"].get(legacy_key, "").strip() if legacy_key else ""
        if not legacy:
            return default
        try:
            return (float(legacy),)
        except ValueError:
            return default
    try:
        delays = tuple(float(part) for part in raw.split(",") if part.strip())
    except ValueError:
        return default
    return delays or default


def _config_bool(config: configparser.ConfigParser, key: str, default: bool) -> bool:
    try:
        return config["default"].getboolean(key, fallback=default)
    except ValueError:
        return default


