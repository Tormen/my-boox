                    "doc-b": {"name": "report.pdf", "size": 42, "rev": "1-b", "updatedAt": 100},
                },
            }
            save_cache(cache_path, cache)

            deleted = []

            def fake_delete(cloud: Any, token: Any, doc_ids: Any, known_revs: Any, debug: Any = False) -> Any:
                deleted.extend(doc_ids)
