            self.assertEqual(sorted(deleted), ["doc-a", "doc-b"])
            reloaded = load_cache(cache_path)
            self.assertNotIn("doc-a", reloaded["docs"])
            self.assertNotIn("doc-b", reloaded["docs"])
            self.assertIn("deleted: doc-b", stdout.getvalue())


def _run_action(action: Callable[[Optional[str]], Any], *_a: Any, **_k: Any) -> Any:
    """with_reauth stand-in for tests: run the action with a dummy token."""
    return action("token")


def _fake_item(doc_id: str = "doc-1", rev: str = "1-abc",
               basename: str = "sample.txt", size: int = 11) -> Dict[str, Any]:
    """An upload_one() result, for tests that exercise everything after the
    OSS upload without performing one."""
    return {
        "doc_id": doc_id, "rev": rev, "revisions": {"start": 1, "ids": [rev.split("-", 1)[1]]},
        "uid": "uid1", "basename": basename, "resource_type": "txt",
        "remotename": f"uid1/push/{doc_id}.txt", "size": size,
        "bucket_name": "onyx-cloud", "sign_url_fn": lambda key: "https://oss.invalid/" + key,
    }


class _FakeResponse:
    """Minimal stand-in for requests.Response -- only the three attributes
    _paced_request/api_call/neocloud_request actually touch."""

    def __init__(self, status_code: int = 200, payload: Any = None,
                 text: str = "") -> None:
        self.status_code = status_code
        self._payload = payload
        self.text = text if text else json.dumps(payload)

    def json(self) -> Any:
        if self._payload is None:
            raise ValueError("no json")
        return self._payload


class _FakeRequests:
    """Stands in for the `requests` module. Each call pops the next queued
    response (or raises the next queued exception) and records the call."""

    class RequestException(Exception):
        pass

    def __init__(self, queue: Sequence[Any]) -> None:
        self._queue = list(queue)
        self.calls = []

    def request(self, method: str, url: str, headers: Any = None,
                params: Any = None, data: Any = None,
                timeout: Any = None) -> Any:
        self.calls.append({"method": method, "url": url, "headers": headers,
                           "params": params, "data": data})
        nxt = self._queue.pop(0)
        if isinstance(nxt, Exception):
            raise nxt
        return nxt


@contextlib.contextmanager
def _no_pacing(module: Any, requests_stub: Any = None,
               attempts: Optional[int] = None) -> Any:
    """Run a block with the sleep-based pacing disabled (tests must not
    spend real seconds) and, optionally, a stubbed `requests` module."""
    patches = [
        mock.patch.object(module, "_api_pacing", 0),
        mock.patch.object(module, "_api_retry_delays", (0.0,)),
        mock.patch.object(module, "_last_request_time", 0.0),
        mock.patch.object(module, "time", mock.Mock(monotonic=time.monotonic,
                                                    sleep=lambda _s: None,
                                                    time=time.time)),
    ]
    if requests_stub is not None:
        patches.append(mock.patch.object(module, "requests", requests_stub))
    if attempts is not None:
        patches.append(mock.patch.object(module, "_api_retry_attempts", attempts))
    with contextlib.ExitStack() as stack:
        for p in patches:
            stack.enter_context(p)
        yield


class TestRegressions(unittest.TestCase):
    """One test per failure actually observed in a real run (or reproduced
    from one). Each names the symptom it locks down."""

    # -- 'ls' against a live account crashed with
    #    "TypeError: '>' not supported between instances of 'str' and 'int'"
    #    because /neocloud/ returned updatedAt as a string for some docs.
    def test_ls_survives_string_timestamps_and_sizes(self) -> None:
        module = sys.modules[__name__]
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = os.path.join(tmpdir, "my-boox.ini")
            config = load_config(config_path)
            docs = {
                "aaa": {"name": "old.pdf", "size": "1024", "rev": "1-a",
                        "createdAt": "1700000000000", "updatedAt": "1700000000000"},
                "bbb": {"name": "new.pdf", "size": 2048, "rev": "1-b",
                        "createdAt": 1800000000000, "updatedAt": 1800000000000},
                "ccc": {"name": "undated.pdf", "size": 7, "rev": "1-c",
                        "createdAt": None, "updatedAt": None},
                "ddd": {"name": "garbled.pdf", "size": "not-a-number",
                        "rev": "1-d", "updatedAt": "also-not-a-number"},
            }
            with mock.patch.object(module, "with_reauth",
                                   side_effect=_run_action), \
                 mock.patch.object(module, "refresh_cache", return_value=docs):
                stdout = io.StringIO()
                with contextlib.redirect_stdout(stdout):
                    groups = cmd_ls(config, config_path, debug=False)

            self.assertEqual([g["name"] for g in groups[:2]],
                             ["new.pdf", "old.pdf"])  # newest first, no crash
            self.assertIn("1,024", stdout.getvalue().replace(" ", ","))

    # -- a server-side "42" and a local getsize() 42 must be one file, not
    #    two rows and a duplicate upload.
    def test_group_docs_treats_string_and_int_size_as_one_file(self) -> None:
        groups = group_docs({
            "ours": {"name": "report.pdf", "size": 42, "updatedAt": 2},
            "theirs": {"name": "report.pdf", "size": "42", "updatedAt": 1},
        })
        self.assertEqual(len(groups), 1)
        self.assertEqual(sorted(groups[0]["ids"]), ["ours", "theirs"])
        self.assertEqual(groups[0]["size"], 42)

    # -- `my-boox --config PATH ls` skipped the venv bootstrap and then died
    #    with "'NoneType' object has no attribute 'RequestException'".
    def test_venv_bootstrap_runs_whenever_a_command_is_present(self) -> None:
        needs_venv = [
            ["ls"],
            ["--config", "/tmp/x.ini", "ls"],
            ["--config=/tmp/x.ini", "ls"],
            ["-D", "--config", "/tmp/x.ini", "send", "a.pdf"],
            ["del", "abc123"],
        ]
        for argv in needs_venv:
            with self.subTest(argv=argv):
                self.assertFalse(_should_skip_venv_bootstrap(argv))

        skips_venv = [
            ["--config"], ["--help"], ["-h"], ["--version"], ["-V"],
            ["--create-config"], ["--create-config", "/tmp/x.ini"],
            ["--create-config=/tmp/x.ini"], ["--run-tests"], ["--run-tests=core"],
        ]
        for argv in skips_venv:
            with self.subTest(argv=argv):
                self.assertTrue(_should_skip_venv_bootstrap(argv))

    # -- missing deps reported as themselves, with exit 203, instead of an
    #    AttributeError on None deep inside the first request.
    def test_missing_dependency_reports_exit_203(self) -> None:
        module = sys.modules[__name__]
        with mock.patch.object(module, "requests", None), \
             mock.patch.object(module, "oss2", None):
            stderr = io.StringIO()
            with contextlib.redirect_stderr(stderr):
                with self.assertRaises(SystemExit) as ctx:
                    _require_deps()
        self.assertEqual(ctx.exception.code, 203)
        self.assertIn("requests", stderr.getvalue())
        self.assertIn("oss2", stderr.getvalue())

    # -- '--config=PATH' fell through to the command slot and was rejected
    #    as "unknown command: --config=/path".
    def test_equals_forms_of_config_flags_are_parsed(self) -> None:
        stdout = io.StringIO()
        with contextlib.redirect_stdout(stdout):
            rc = main(["--config=/tmp/does-not-exist.ini"])
        self.assertEqual(rc, 0)
        self.assertIn("/tmp/does-not-exist.ini", stdout.getvalue())

        # ...and with a command it reaches dispatch (206 = named config
        # missing), rather than dying as an unknown command (201).
        stderr = io.StringIO()
        with contextlib.redirect_stderr(stderr):
            with self.assertRaises(SystemExit) as ctx:
                main(["--config=/tmp/does-not-exist.ini", "ls"])
        self.assertEqual(ctx.exception.code, 206)

        with tempfile.TemporaryDirectory() as tmpdir:
            target = os.path.join(tmpdir, "written.ini")
            stdout = io.StringIO()
            with contextlib.redirect_stdout(stdout):
                rc = main([f"--create-config={target}"])
            self.assertEqual(rc, 0)
            self.assertTrue(os.path.isfile(target))

    # -- '--create-config FILE' silently overwrote an existing config,
    #    destroying the stored token.
    def test_create_config_refuses_to_overwrite(self) -> None:
        with tempfile.TemporaryDirectory() as tmpdir:
            existing = os.path.join(tmpdir, "my-boox.ini")
            with open(existing, "w") as handle:
                handle.write("[default]\ntoken = precious\n")

            stderr = io.StringIO()
            with contextlib.redirect_stderr(stderr):
                rc = main(["--create-config", existing])

            self.assertNotEqual(rc, 0)
            self.assertIn("refusing to overwrite", stderr.getvalue())
            with open(existing) as handle:
                self.assertIn("precious", handle.read())

    # -- the config holds a full account credential; it was written 0644.
    def test_config_and_cache_are_written_owner_only(self) -> None:
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = os.path.join(tmpdir, "my-boox.ini")
            config = load_config(config_path)
            config["default"]["token"] = "secret-token"
            save_config(config_path, config)
            self.assertEqual(os.stat(config_path).st_mode & 0o777, 0o600)

            cache_path = resolve_cache_path(config, config_path)
            save_cache(cache_path, {"last_seq": "1", "docs": {}})
            self.assertEqual(os.stat(cache_path).st_mode & 0o777, 0o600)

    def test_cache_write_leaves_no_partial_file_on_failure(self) -> None:
