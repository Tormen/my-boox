class TestCacheAndGrouping(unittest.TestCase):
    def test_cache_round_trip_and_path_resolution(self) -> None:
        with tempfile.TemporaryDirectory() as tmpdir:
            config_path = os.path.join(tmpdir, "my-boox.ini")
            config = load_config(config_path)
            cache_path = resolve_cache_path(config, config_path)
            self.assertTrue(cache_path.endswith("my-boox.cache.json"))

            cache = {"last_seq": "0", "docs": {"abc": {"name": "report.pdf", "size": 42, "rev": "1-abc"}}}
            save_cache(cache_path, cache)
            reloaded = load_cache(cache_path)
            self.assertEqual(reloaded["docs"]["abc"]["name"], "report.pdf")

    def test_group_docs_merges_same_logical_file(self) -> None:
        docs = {
            "first": {"name": "report.pdf", "size": 42, "rev": "1-first", "updatedAt": 100},
            "second": {"name": "report.pdf", "size": 42, "rev": "1-second", "updatedAt": 200},
            "third": {"name": "other.pdf", "size": 99, "rev": "1-third", "updatedAt": 50},
        }
        groups = group_docs(docs)
        self.assertEqual(len(groups), 2)
        report = next(group for group in groups if group["name"] == "report.pdf")
        self.assertEqual(sorted(report["ids"]), ["first", "second"])
        self.assertEqual(report["size"], 42)


