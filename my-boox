def print_help(to=sys.stdout):
    to.write(f"""\
my-boox -- send, list, and delete files on an Onyx BOOX device via BOOXDrop.

v3.0: reads and writes /neocloud/ directly (via a local cache), with no
reliance on the legacy push/message listing. Not compatible with ids from
a v2.x 'ls' -- run the one-time cleanup script first if migrating.

USAGE
  my-boox [-D|--debug] [--config PATH] send <FILE> [FILE...]
  my-boox [-D|--debug] [--config PATH] ls|list
  my-boox [-D|--debug] [--config PATH] del|delete <ID> [ID...]
  my-boox [--config [PATH]]
  my-boox [--create-config [PATH]]
  my-boox [--run-tests [GROUP]]
  my-boox [--help]
  my-boox [--version]

COMMANDS
  send FILE [FILE...]
                    Upload one or more files, following exactly the call
                    sequence the BOOXDrop web UI uses: upload to OSS,
                    write our own /neocloud/ document via _revs_diff +
                    _bulk_docs, then api/1/push/saveAndPush carrying
                    'cbMsg' naming that document -- which makes the
                    server adopt it instead of registering a second one.
                    That is why one send now produces one row, not two.
                    Skips any file whose name AND size already match
                    something already present (checked once per batch,
                    plus against files sent earlier in the same batch).
                    If a file still fails after retries, the rest of the
                    batch is still attempted; failures are summarized at
                    the end and the exit code is nonzero.

  ls, list         List files, refreshing the local cache incrementally
                    from /neocloud/ first (cheap after the first run).
                    Use the ID shown with 'del'.

  del ID [ID...]   Delete one or more files by ID (as shown by 'ls'),
                    again mirroring the web UI: tombstone the /neocloud/
                    document (_revs_diff + _bulk_docs), then
                    api/1/push/message/batchDelete for the same id. Both
                    halves are needed -- the tombstone alone leaves the
                    paired push-message record behind.
                    Each id is deleted independently and confirmed as it
                    happens; if one fails, the rest of the batch still
                    goes ahead, with a summary and nonzero exit code if
                    anything genuinely failed.
                    Files sent by a pre-4.0 my-boox have a second, stray
                    document; 'del' expands each id to its whole group so
                    those go too.

Every request any command makes goes through the same central pacing/retry
layer: a minimum interval between requests, and automatic retries with
backoff on a transient server error (502/503/504, connection errors,
timeouts -- these happen even in the real web client). Configurable via
api_pacing_seconds/api_retry_attempts/api_retry_delay_seconds, see CONFIG
below.

All three automatically handle authentication: if the stored token is
missing, expired, or rejected by the server, my-boox requests a fresh
6-digit verification code by email, prompts you for it, exchanges it for a
new token, saves that token back to the config file, and retries the
command once -- no separate login step to run by hand.

OPTIONS
  -D, --debug        Print the JSON of every API call to stderr, with
                    credentials (token, session_id, verification code, STS
                    keys, signed-URL signatures) replaced by a length
                    marker -- so a redirected debug log is safe to keep
                    and to paste into a bug report.
  --config [PATH]     With PATH: use that config file for this run only,
                    instead of the normal search (see CONFIG below). The
                    file must exist; --config on a missing file exits 206
                    rather than silently falling back to the search.
                    Without PATH, and with no command given: print the
                    config path my-boox would currently resolve to, and
                    exit (does not require the file to actually exist).
                    '--config=PATH' works too.
  --create-config [PATH]
                    Write a template config file to PATH. Refuses to
                    overwrite an existing file (your token lives in there).
                    Without PATH, print the template to stdout instead (so
                    you can review it, or redirect it wherever you like) --
                    nothing is written to disk in that case.
                    '--create-config=PATH' works too.
  --run-tests [GROUP]
                    Run the built-in self-tests. GROUP can be one of:
                    smoke, core, commands, regressions, or all
                    (default: all).
  -h, --help         Show this help and exit.
  -V, --version      Show version and git commit, then exit.

CONFIG
  my-boox reads a config file named 'my-boox.conf', in this format:

      [default]
      email =
      token =
      cloud = eur.boox.com
      api_pacing_seconds = 1.5
      api_retry_attempts = 3
      api_retry_delay_seconds = 3.0
      duplicate_check_on_send = true

  email  -- the address tied to your Onyx account. Required: this is who
            re-auth emails a fresh verification code to.
  token  -- filled in automatically the first time you authenticate; leave
            this blank in a fresh config.
  cloud  -- your BOOXDrop server region. 'eur.boox.com' for EU accounts,
            'push.boox.com' for US/VN.
  api_pacing_seconds       -- minimum interval between ANY two requests
            this tool makes. 0 disables it.
  api_retry_attempts       -- how many times to retry any single request
            after a transient server error before giving up on it.
  api_retry_delay_seconds  -- base backoff delay between retries
            (multiplied by the attempt number, so e.g. 3.0 gives 3s, 6s).
  duplicate_check_on_send   -- true/false. When true (default), 'send'
            skips any file whose name AND size already match something
            already present. Set false to always upload regardless.
  send_skip_optional_calls -- true/false, default false. 'send' makes two
            calls (users/getDevice, im/getSig) whose responses are thrown
            away; they exist only because the upstream project mirrored
            the web client. Setting this true skips them, saving two
            requests (and two pacing intervals) per file. UNVERIFIED: a
            similarly redundant-looking call (saveAndPush) turned out to
            be required for delivery, so test on-device before trusting
            this for a real batch.
  cache_path  -- where the local /neocloud/ mirror is kept. Blank (default)
            uses '<this config file's path>.neocloud-cache.json'. Set an
            absolute path to use somewhere else. See LOCAL CACHE below for
            the file's structure.

  The file is written 0600 (owner-only): 'token' is a full credential for
  the account -- anything that can read it can send to and delete from the
  device. my-boox re-writes the file at that mode every time it refreshes
  the token; tighten an existing one by hand with:
      chmod 600 ~/.my-boox.conf

  SEARCH ORDER (first match wins, no merging across locations):
      0. $MY_BOOX_CONFIG, if set and non-empty (wins outright)
      1. /LINKS/default/my-boox.conf
      2. ~/.my-boox.conf        (dot-prefixed, home only)
      3. /etc/my-boox.conf
      4. /usr/local/etc/my-boox.conf

  Running a command with no config anywhere in that order exits 206 with
  the list of paths searched.

  Run 'my-boox --config' with no other arguments at any time to see exactly
  which of these paths it currently resolves to.

  A '--config PATH' passed alongside a command overrides the search
  entirely for that single run.

LOCAL CACHE
  By default, '<config path>.neocloud-cache.json' mirrors /neocloud/'s
  contents (id, name, size, rev, timestamps), refreshed incrementally on
  every 'ls' via one cheap _changes call plus a body fetch only for
  new/changed documents. This is what 'ls' and 'del' actually read/act on.
  Set 'cache_path' in the config to use a different location instead (e.g.
  to share one cache across configs, or keep it off a synced directory).
  Delete the cache file (or empty its "docs" object) to force a full
  resync from scratch. See the comments in 'my-boox --create-config' for
  the cache file's exact JSON structure.

SELF-MANAGED VIRTUALENV
  my-boox has two dependencies (requests, oss2) and manages its own
  virtualenv for them automatically -- nothing to pip install by hand.
  On first run, it creates a venv at ~/.python.venv/my-boox, installs both
  packages into it, then re-execs itself under that interpreter. Delete
  that directory to force a clean reinstall.

EXAMPLES
  my-boox --create-config              # see the template
  my-boox --create-config ~/.my-boox.conf # write it there
  my-boox --config                     # where would my-boox look?
  my-boox send report.pdf
  my-boox send a.pdf b.pdf c.pdf        # multiple files in one call
  my-boox ls
  my-boox del <id>
  my-boox del <id1> <id2>
  my-boox -D ls                        # with raw API responses on stderr

EXIT CODES
  201  wrong usage / missing arg / unknown command / refused to overwrite
  202  send: every failure was a file that does not exist locally (if
       anything else failed too, 204 wins)
  203  a dependency (requests, oss2) is missing -- the managed venv is
       absent or half-built; remove ~/.python.venv/my-boox and re-run
  204  action failed even after re-auth retry, or a file failed to upload
  205  re-auth step itself failed (no email configured, no code entered,
       stdin is not a terminal so no code could be prompted for, or the
       request-code/obtain-token API call itself failed)
  206  no config file found (search order exhausted, or the --config PATH
       given does not exist)
""")


def main(argv):
    debug = False
    config_override = None
    config_flag = False
    create_config_flag = False
    create_config_path = None
    run_tests = False
    test_group = None
    rest = []

    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-D", "--debug"):
            debug = True
        elif a == "--config":
            config_flag = True
            if i + 1 < len(argv) and argv[i + 1] not in KNOWN_CMDS and not argv[i + 1].startswith("-"):
                config_override = argv[i + 1]
                i += 1
        elif a.startswith("--config="):
            config_flag = True
            config_override = a.split("=", 1)[1] or None
        elif a == "--create-config":
            create_config_flag = True
            if i + 1 < len(argv) and argv[i + 1] not in KNOWN_CMDS and not argv[i + 1].startswith("-"):
                create_config_path = argv[i + 1]
                i += 1
        elif a.startswith("--create-config="):
            create_config_flag = True
            create_config_path = a.split("=", 1)[1] or None
        elif a == "--run-tests":
            run_tests = True
            if i + 1 < len(argv) and argv[i + 1] not in KNOWN_CMDS and not argv[i + 1].startswith("-"):
                test_group = argv[i + 1]
                i += 1
        elif a.startswith("--run-tests="):
            run_tests = True
            test_group = a.split("=", 1)[1] or None
        elif a in ("-h", "--help"):
            print_help(sys.stdout)
            return 0
        elif a in ("-V", "--version"):
            commit = _get_git_commit() or GIT_COMMIT_FALLBACK
            print(f"my-boox {VERSION} (commit {commit})")
            return 0
        else:
            rest.append(a)
        i += 1

    if run_tests:
        return run_self_tests(test_group)

    if create_config_flag:
        if create_config_path:
            path = os.path.expanduser(create_config_path)
            # Never clobber: by the time a config exists it holds a working
            # token (and possibly a hand-tuned cache_path), and overwriting
            # it with the blank template silently throws both away.
            if os.path.exists(path):
                sys.stderr.write(
                    f"my-boox: refusing to overwrite existing file: {path}\n"
                    f"my-boox: remove it first, or write the template elsewhere\n"
                )
                return 201
            _write_file_atomic(path, CONFIG_TEMPLATE, mode=0o600)
            print(f"wrote template config to {path}")
        else:
            sys.stdout.write(CONFIG_TEMPLATE)
        return 0

    if not rest:
        if config_flag:
            print(config_override or resolve_config_path())
            return 0
        print_usage()
        return 201

    cmd = rest[0]
    cmd_args = rest[1:]

    if cmd not in KNOWN_CMDS:
        sys.stderr.write(f"my-boox: unknown command: {cmd} (expected send, ls, or del)\n")
        return 201

    if config_override:
        config_path = os.path.expanduser(config_override)
        if not os.path.isfile(config_path):
            die(f"my-boox: config file not found: {config_path}", 206)
    else:
        # required=True: without a config there is no email to send a
        # verification code to, so the run cannot succeed. Saying so up
        # front (206) beats failing several requests later with the much
        # vaguer "no email configured".
        config_path = resolve_config_path(required=True)
    config = load_config(config_path)

    global API_PACING, API_RETRY_ATTEMPTS, API_RETRY_DELAY
    API_PACING = _config_float(config, "api_pacing_seconds", DEFAULT_PACING)
    API_RETRY_ATTEMPTS = _config_int(config, "api_retry_attempts", DEFAULT_RETRY_ATTEMPTS)
    API_RETRY_DELAY = _config_float(config, "api_retry_delay_seconds", DEFAULT_RETRY_DELAY)

    # Last gate before anything touches the network.
    _require_deps()

    try:
        if cmd == "send":
            if not cmd_args:
                sys.stderr.write("usage: my-boox send FILE [FILE...]\n")
                return 201
            cmd_send(config, config_path, cmd_args, debug=debug)
            return 0

        if cmd in ("ls", "list"):
            cmd_ls(config, config_path, debug=debug)
            return 0

        if cmd in ("del", "delete"):
            if not cmd_args:
                sys.stderr.write("usage: my-boox del ID [ID...]\n")
                return 201
            cmd_del(config, config_path, cmd_args, debug=debug)
            return 0
    except (BooxAPIError, BooxAuthError) as e:
        die(f"my-boox: {e}", 204)
    except SystemExit:
        raise
    except Exception as e:
        if debug:
            raise
        die(f"my-boox: unexpected error: {e} (rerun with -D for the full traceback)", 204)

    # unreachable given the KNOWN_CMDS check above
    return 201


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
